---
interface Props {
  activeNav?: string;
}
const { activeNav = "" } = Astro.props;

// Series & Collections Items (Hierarchical Dropdown)
const seriesItems = [
  { href: "ocean-kits.html", label: "Ocean Kits", icon: "🌊", badge: "Ages 3–9", desc: "4 themed learning combo kits", color: "#00B4D8" },
  { href: "divine-stories.html", label: "Divine Stories", icon: "✨", badge: "Personalised", desc: "God tales with child's name", color: "#7209B7" },
  { href: "return-gifts.html", label: "Return Gifts", icon: "🎁", badge: "From ₹39", desc: "Birthday packs & ready combos", color: "#E76F51" },
  { href: "products.html", label: "All Products", icon: "🛍️", badge: "Full Shop", desc: "Activity & reusable wipe-clean books", color: "#F4A227" },
];

const isSeriesActive = ["products.html", "ocean-kits.html", "divine-stories.html", "return-gifts.html"].includes(activeNav);
---
<!-- ═══════════════════════════════════════════════════════════
     PROPERLY ALIGNED, SIMPLIFIED HEADER WITH SERIES DROPDOWN
     ═══════════════════════════════════════════════════════════ -->
<header class="hb-header-wrap">
  <nav id="mainNav" class="hb-navbar" aria-label="Main navigation">
    <!-- 1. Left: Brand Logo -->
    <a class="hb-brand" href="index.html" aria-label="HoneyBee Learning Home">
      <div class="hb-logo-badge">
        <img src="images/logo/logo.png" alt="HoneyBee Learning Logo" class="hb-logo-img">
        <span class="hb-bee-decor" aria-hidden="true">🐝</span>
      </div>
      <div class="hb-brand-copy">
        <div class="hb-brand-title">
          <span class="hb-brand-honey">HoneyBee</span>
          <span class="hb-brand-learning">Learning</span>
        </div>
        <span class="hb-brand-tagline">India's 1st Personalised Books</span>
      </div>
    </a>

    <!-- 2. Center: Simplified, Properly Aligned Navigation Links -->
    <ul class="hb-desktop-links" id="desktopNavLinks">
      <!-- Home Link -->
      <li>
        <a
          href="index.html"
          class={activeNav === "index.html" || activeNav === "" ? "hb-nav-link active" : "hb-nav-link"}
          aria-current={activeNav === "index.html" || activeNav === "" ? "page" : undefined}
        >
          <span>Home</span>
        </a>
      </li>

      <!-- Products / Series Dropdown Trigger -->
      <li class="hb-dropdown-parent" id="hbDropdownParent">
        <button
          type="button"
          class={isSeriesActive ? "hb-nav-link hb-dropdown-trigger active" : "hb-nav-link hb-dropdown-trigger"}
          aria-expanded="false"
          aria-haspopup="true"
          id="seriesDropdownBtn"
        >
          <span>Products / Series</span>
          <svg class="hb-caret-icon" viewBox="0 0 12 12" width="11" height="11" fill="currentColor" aria-hidden="true">
            <path d="M2.2 4.2a.8.8 0 0 1 1.1 0L6 6.9l2.7-2.7a.8.8 0 1 1 1.1 1.1L6.5 8.6a.8.8 0 0 1-1.1 0L2.2 5.3a.8.8 0 0 1 0-1.1z"/>
          </svg>
        </button>

        <!-- Dropdown Menu Card -->
        <div class="hb-dropdown-menu" id="seriesDropdownMenu" role="menu" aria-labelledby="seriesDropdownBtn">
          <div class="hb-dropdown-header">
            <span class="hb-dropdown-eyebrow">Collections & Series</span>
          </div>
          <div class="hb-dropdown-grid">
            {seriesItems.map((item) => (
              <a
                href={item.href}
                class={activeNav === item.href ? "hb-drop-item active" : "hb-drop-item"}
                role="menuitem"
              >
                <span class="hb-drop-icon" style={`background: ${item.color}15; color: ${item.color};`}>
                  {item.icon}
                </span>
                <div class="hb-drop-text">
                  <div class="hb-drop-row">
                    <span class="hb-drop-title">{item.label}</span>
                    <span class="hb-drop-badge">{item.badge}</span>
                  </div>
                  <span class="hb-drop-desc">{item.desc}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </li>

      <!-- Bee Points Link -->
      <li>
        <a
          href="bee-points.html"
          class={activeNav === "bee-points.html" ? "hb-nav-link active" : "hb-nav-link"}
          aria-current={activeNav === "bee-points.html" ? "page" : undefined}
        >
          <span>Bee Points 🐝</span>
        </a>
      </li>

      <!-- Reviews Link -->
      <li>
        <a
          href="reviews.html"
          class={activeNav === "reviews.html" ? "hb-nav-link active" : "hb-nav-link"}
          aria-current={activeNav === "reviews.html" ? "page" : undefined}
        >
          <span>Reviews ⭐</span>
        </a>
      </li>

      <!-- Our Story Link -->
      <li>
        <a
          href="about.html"
          class={activeNav === "about.html" ? "hb-nav-link active" : "hb-nav-link"}
          aria-current={activeNav === "about.html" ? "page" : undefined}
        >
          <span>Our Story 🍯</span>
        </a>
      </li>
    </ul>

    <!-- 3. Right: Quick Actions -->
    <div class="hb-nav-actions">
      <!-- Quick Mobile WhatsApp Tap -->
      <a
        href="https://wa.me/918883624873?text=Hi%20HoneyBee%20Learning%2C%20I%20have%20an%20enquiry!"
        target="_blank"
        rel="noopener"
        class="hb-wa-mobile-btn"
        aria-label="Order on WhatsApp"
      >
        <span class="hb-wa-pulse" aria-hidden="true"></span>
        <span class="hb-wa-icon" aria-hidden="true">💬</span>
      </a>

      <!-- Desktop Primary WhatsApp Button -->
      <a
        href="https://wa.me/918883624873?text=Hi%20HoneyBee%20Learning%2C%20I%20have%20an%20enquiry!"
        target="_blank"
        rel="noopener"
        class="hb-desktop-cta"
      >
        <span class="hb-cta-icon" aria-hidden="true">💬</span>
        <span>WhatsApp Us</span>
      </a>

      <!-- Animated Hamburger Button -->
      <button
        class="hb-hamburger-btn"
        id="hamburger"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="hbDrawerPanel"
      >
        <span class="hb-hamb-box" aria-hidden="true">
          <span class="hb-hamb-line hb-line-1"></span>
          <span class="hb-hamb-line hb-line-2"></span>
          <span class="hb-hamb-line hb-line-3"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Backdrop Blur Overlay -->
<div class="hb-drawer-backdrop" id="hbNavOverlay" aria-hidden="true"></div>

<!-- Mobile Side Drawer (Cleanly Grouped with Series) -->
<aside
  class="hb-side-drawer"
  id="hbDrawerPanel"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Drawer"
>
  <!-- Drawer Header Card -->
  <div class="hb-drawer-header">
    <div class="hb-drawer-brand">
      <img src="images/logo/logo.png" alt="HoneyBee Logo" class="hb-drawer-logo">
      <div>
        <div class="hb-drawer-title">HoneyBee <em>Learning</em></div>
        <div class="hb-drawer-subtitle">🏆 India Book of Records Holder</div>
      </div>
    </div>
    <button
      class="hb-drawer-close-btn"
      id="hbDrawerClose"
      type="button"
      aria-label="Close navigation menu"
    >
      <span aria-hidden="true">✕</span>
    </button>
  </div>

  <!-- Drawer Body Navigation -->
  <div class="hb-drawer-body">
    <!-- Quick Home Tile -->
    <a href="index.html" class={activeNav === "index.html" || activeNav === "" ? "hb-tile-link active" : "hb-tile-link"} style="margin-bottom: 14px;">
      <span class="hb-tile-icon" style="background: rgba(244, 162, 39, 0.15); color: #F4A227;">🏠</span>
      <div class="hb-tile-content">
        <span class="hb-tile-title">Home</span>
        <span class="hb-tile-desc">Storefront, top picks & founder intro</span>
      </div>
      <span class="hb-tile-arrow" aria-hidden="true">→</span>
    </a>

    <!-- Series & Products Section -->
    <div class="hb-drawer-section-title">Products & Series</div>
    <ul class="hb-drawer-menu" id="navLinks">
      {seriesItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={activeNav === item.href ? "hb-tile-link active" : "hb-tile-link"}
            aria-current={activeNav === item.href ? "page" : undefined}
          >
            <span class="hb-tile-icon" style={`background: ${item.color}15; color: ${item.color};`} aria-hidden="true">
              {item.icon}
            </span>
            <div class="hb-tile-content">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:4px;">
                <span class="hb-tile-title">{item.label}</span>
                <span class="hb-drop-badge">{item.badge}</span>
              </div>
              <span class="hb-tile-desc">{item.desc}</span>
            </div>
            <span class="hb-tile-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Loyalty, Reviews & Story Section -->
    <div class="hb-drawer-section-title" style="margin-top: 18px;">Loyalty & Community</div>
    <ul class="hb-drawer-menu">
      <li>
        <a href="bee-points.html" class={activeNav === "bee-points.html" ? "hb-tile-link active" : "hb-tile-link"}>
          <span class="hb-tile-icon" style="background: rgba(230, 57, 70, 0.12); color: #E63946;">🐝</span>
          <div class="hb-tile-content">
            <span class="hb-tile-title">Bee Points</span>
            <span class="hb-tile-desc">Check balance, tiers & rewards</span>
          </div>
          <span class="hb-tile-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="reviews.html" class={activeNav === "reviews.html" ? "hb-tile-link active" : "hb-tile-link"}>
          <span class="hb-tile-icon" style="background: rgba(255, 183, 3, 0.15); color: #FFB703;">⭐</span>
          <div class="hb-tile-content">
            <span class="hb-tile-title">Customer Reviews</span>
            <span class="hb-tile-desc">4.9★ Real parent photos & video reviews</span>
          </div>
          <span class="hb-tile-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="about.html" class={activeNav === "about.html" ? "hb-tile-link active" : "hb-tile-link"}>
          <span class="hb-tile-icon" style="background: rgba(42, 157, 143, 0.15); color: #2A9D8F;">🍯</span>
          <div class="hb-tile-content">
            <span class="hb-tile-title">Our Story</span>
            <span class="hb-tile-desc">Meet founder Shanmugi (Record Holder)</span>
          </div>
          <span class="hb-tile-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="faq.html" class={activeNav === "faq.html" ? "hb-tile-link active" : "hb-tile-link"}>
          <span class="hb-tile-icon" style="background: rgba(114, 9, 183, 0.12); color: #7209B7;">❓</span>
          <div class="hb-tile-content">
            <span class="hb-tile-title">Help & FAQ</span>
            <span class="hb-tile-desc">Delivery times, customization & orders</span>
          </div>
          <span class="hb-tile-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>

    <!-- Direct Founder Assistance Card -->
    <div class="hb-drawer-founder-card">
      <div class="hb-founder-header">
        <span class="hb-founder-avatar">👩‍🏫</span>
        <div>
          <div class="hb-founder-name">Chat with Founder Shanmugi</div>
          <div class="hb-founder-status">🟢 Online · Fast WhatsApp reply</div>
        </div>
      </div>
      <a
        href="https://wa.me/918883624873?text=Hi%20Shanmugi%2C%20I%20am%20looking%20for%20personalised%20learning%20books%20for%20my%20child!"
        target="_blank"
        rel="noopener"
        class="hb-founder-wa-btn"
      >
        <span>Message on WhatsApp</span>
        <span aria-hidden="true">💬</span>
      </a>
    </div>

    <!-- Quick Contact Footer in Drawer -->
    <div class="hb-drawer-contacts">
      <a href="tel:8883624873" class="hb-contact-pill">
        <span>📞</span> Call: 8883624873
      </a>
      <a
        href="https://www.instagram.com/honeybee.learning.co?igsh=aDJ3enhnNWs1eHZ0"
        target="_blank"
        rel="noopener"
        class="hb-contact-pill"
      >
        <span>📸</span> Instagram (@honeybee.learning.co)
      </a>
      <div class="hb-drawer-badge">📍 Medavakkam, Chennai · Pan-India Delivery</div>
    </div>
  </div>
</aside>

<!-- ═══════════════════════════════════════════════════════════
     HEADER & DROPDOWN STYLES (CLEAN, PROPERLY ALIGNED)
     ═══════════════════════════════════════════════════════════ -->
<style is:global>
  /* 1. Header Wrapper & Glass Navbar */
  .hb-header-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 253, 247, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1.5px solid rgba(244, 162, 39, 0.22);
    box-shadow: 0 4px 20px -2px rgba(60, 40, 10, 0.06);
    transition: transform 0.25s ease, opacity 0.2s ease, visibility 0.2s, background 0.3s, box-shadow 0.3s;
  }

  /* Automatically suppress site header when any modal is open so close button is completely unobstructed */
  body.modal-open .hb-header-wrap,
  body:has(.modal-overlay.open) .hb-header-wrap,
  body:has(.dmodal-overlay.open) .hb-header-wrap,
  body:has(.explainer-overlay.open) .hb-header-wrap {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    z-index: -1 !important;
    transform: translateY(-100%) !important;
  }

  .hb-navbar {
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
  }

  /* 2. Brand Identity */
  .hb-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .hb-logo-badge {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #FFF9E6;
    border: 1.5px solid rgba(244, 162, 39, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(244, 162, 39, 0.2);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hb-brand:hover .hb-logo-badge {
    transform: rotate(-6deg) scale(1.05);
  }

  .hb-logo-img {
    height: 38px;
    width: 38px;
    object-fit: contain;
    border-radius: 9px;
  }

  .hb-bee-decor {
    position: absolute;
    top: -6px;
    right: -8px;
    font-size: 14px;
    animation: hbBeeFloat 3s ease-in-out infinite;
  }

  @keyframes hbBeeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(8deg); }
  }

  .hb-brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .hb-brand-title {
    font-family: 'Fredoka One', cursive, sans-serif;
    font-size: 1.45rem;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .hb-brand-honey {
    color: #1E5E3A;
  }

  .hb-brand-learning {
    background: linear-gradient(135deg, #F4A227, #E76F51);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hb-brand-tagline {
    font-size: 0.68rem;
    font-weight: 700;
    color: #8C6D53;
    letter-spacing: 0.2px;
  }

  /* 3. Center Navigation Pills (Clean & Simple) */
  .hb-desktop-links {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hb-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 700;
    color: #4A3B32;
    text-decoration: none;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    white-space: nowrap;
  }

  .hb-nav-link:hover {
    background: rgba(244, 162, 39, 0.12);
    color: #D9601A;
    transform: translateY(-1px);
  }

  .hb-nav-link.active {
    background: linear-gradient(135deg, #F4A227, #E76F51);
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(244, 162, 39, 0.35);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* 4. Dropdown Container & Menu */
  .hb-dropdown-parent {
    position: relative;
    list-style: none;
  }

  .hb-dropdown-trigger {
    padding-right: 12px;
  }

  .hb-caret-icon {
    transition: transform 0.25s ease;
  }

  .hb-dropdown-parent.is-open .hb-caret-icon,
  .hb-dropdown-parent:hover .hb-caret-icon {
    transform: rotate(180deg);
  }

  .hb-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 320px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid rgba(244, 162, 39, 0.25);
    border-radius: 18px;
    box-shadow: 0 16px 40px -8px rgba(50, 30, 10, 0.16);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
    z-index: 1050;
  }

  /* Desktop hover & open states */
  .hb-dropdown-parent:hover .hb-dropdown-menu,
  .hb-dropdown-parent.is-open .hb-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .hb-dropdown-header {
    padding: 6px 10px 8px;
    border-bottom: 1px solid rgba(240, 235, 225, 0.9);
    margin-bottom: 6px;
  }

  .hb-dropdown-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #9C8370;
  }

  .hb-dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hb-drop-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s, transform 0.2s;
  }

  .hb-drop-item:hover {
    background: #FFFDF5;
    transform: translateX(3px);
  }

  .hb-drop-item.active {
    background: linear-gradient(135deg, #FFF6E5, #FFF0D4);
  }

  .hb-drop-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .hb-drop-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .hb-drop-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .hb-drop-title {
    font-size: 0.9rem;
    font-weight: 800;
    color: #2D231C;
  }

  .hb-drop-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 6px;
    background: #FFF3DA;
    color: #D9601A;
    border: 1px solid rgba(244, 162, 39, 0.25);
  }

  .hb-drop-desc {
    font-size: 0.72rem;
    color: #7A695B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 5. Right Action Controls */
  .hb-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .hb-desktop-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    border-radius: 999px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #FFFFFF !important;
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .hb-desktop-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }

  .hb-wa-mobile-btn {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #25D366;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    color: #FFFFFF;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .hb-wa-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: hbPulse 2s infinite;
  }

  @keyframes hbPulse {
    0% { transform: scale(0.95); opacity: 1; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  /* 6. Animated Hamburger Button */
  .hb-hamburger-btn {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid rgba(244, 162, 39, 0.3);
    border-radius: 12px;
    background: #FFFDF5;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    touch-action: manipulation;
  }

  .hb-hamburger-btn:hover {
    background: #FFF5DE;
    border-color: #F4A227;
  }

  .hb-hamb-box {
    position: relative;
    width: 22px;
    height: 16px;
    display: flex;
    flex-direction: column;
