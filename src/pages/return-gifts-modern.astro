---
import SiteLayout from "../layouts/SiteLayout.astro";
import giftPacks from "../../data/return-gifts.json";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Birthday Return Gifts Preview | HoneyBee Learning" description="Browse personalised educational birthday return gift packs in a responsive preview." noIndex={true}>
  <section class="gift-hero">
    <div class="container hero-grid">
      <div>
        <a class="back-link" href={`${base}modern-preview.html`}>← Back to design preview</a>
        <span class="eyebrow">Small gifts. Big happy memories.</span>
        <h1>Party favours that <span>keep on giving.</span></h1>
        <p>Personalised, activity-filled return gifts made for little guests. Choose a budget, explore what's inside, and ask us about your party order.</p>
        <div class="hero-pills"><span>🎨 Personalised activities</span><span>🎁 Ready-to-gift packs</span><span>🚚 Pan-India delivery</span></div>
      </div>
      <div class="hero-art"><img src={`${base}images/logo/logo.png`} alt="HoneyBee Learning" /><span aria-hidden="true" class="floating f1">🎁</span><span aria-hidden="true" class="floating f2">🌈</span><span aria-hidden="true" class="floating f3">✏️</span></div>
    </div>
  </section>
  <section class="gift-section">
    <div class="container">
      <div class="gift-toolbar">
        <div><span class="eyebrow">Find your party fit</span><h2>Choose a gift pack</h2></div>
        <label class="search"><span class="sr-only">Search gift packs</span><span aria-hidden="true">⌕</span><input id="gift-search" type="search" placeholder="Search packs…" /></label>
      </div>
      <div class="filters" role="group" aria-label="Filter by budget">
        <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">All packs</button>
        <button class="filter" type="button" data-filter="under50" aria-pressed="false">Under ₹50</button>
        <button class="filter" type="button" data-filter="under100" aria-pressed="false">₹50–₹100</button>
        <button class="filter" type="button" data-filter="under200" aria-pressed="false">₹101–₹200</button>
        <button class="filter" type="button" data-filter="premium" aria-pressed="false">Premium</button>
      </div>
      <p id="gift-count" class="count" aria-live="polite">Showing {giftPacks.length} gift packs</p>
      <div id="gift-grid" class="gift-grid">
        {giftPacks.map((gift) => (
          <article class="gift-card" data-category={gift.category} data-search={`${gift.name} ${gift.items.join(" ")}`.toLowerCase()}>
            <div class="gift-art"><span class="gift-emoji" aria-hidden="true">{gift.emoji}</span><span class="gift-price">₹{gift.price}<small> / child</small></span></div>
            <div class="gift-content">
              <span class="budget-label">{gift.mrpLabel}</span>
              <h3>{gift.name}</h3>
              <ul>{gift.items.map((item) => <li>{item}</li>)}</ul>
              <a class="order-button" href={`https://wa.me/918883624873?text=${encodeURIComponent(`Hi! I'm interested in the ${gift.name} (₹${gift.price} per child) for a birthday return gift order. Please share details.`)}`} target="_blank" rel="noopener noreferrer">Ask about this pack <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
      <div id="gift-empty" hidden class="empty"><span aria-hidden="true">🎁</span><h2>No packs match yet</h2><p>Try another budget or search term.</p><button id="gift-reset" type="button">Clear filters</button></div>
      <p class="note">Prices and inclusions are sourced from the existing return-gifts data. Confirm availability, quantity discounts, and personalisation details with HoneyBee Learning before ordering.</p>
    </div>
  </section>
  <section class="gift-steps"><div class="container"><div class="section-heading"><span class="eyebrow">Easy as 1, 2, 3</span><h2>From party plan to happy hands.</h2></div><div class="steps"><article><span>01</span><h3>Choose your pack</h3><p>Pick a pack that suits your budget and little guests.</p></article><article><span>02</span><h3>Share the details</h3><p>Message us with your quantity, date, and personalisation needs.</p></article><article><span>03</span><h3>We prepare the gifts</h3><p>We’ll confirm the order and next steps with you.</p></article></div></div></section>
</SiteLayout>
<style>
  .gift-hero { overflow: hidden; padding-block: clamp(2.5rem, 7vw, 5rem); background: radial-gradient(ellipse at 85% 20%, #fff0bd, transparent 35%), linear-gradient(135deg, #fffdf5, #f1f7e8); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(14rem, .75fr); align-items: center; gap: 2rem; }
  .back-link { display: inline-block; margin-bottom: 1.4rem; color: var(--color-leaf); font-weight: 900; text-decoration: none; }.eyebrow { color: var(--color-leaf); font-size: .78rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 46rem; margin-top: .65rem; font-size: clamp(2.5rem, 6vw, 4.6rem); line-height: 1.06; } h1 span { color: var(--color-leaf); }
  .hero-grid p { max-width: 43rem; margin-top: 1rem; color: var(--color-muted); font-size: 1.05rem; }.hero-pills { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }.hero-pills span { padding: .55rem .8rem; border: 1px solid #e2e8d7; border-radius: 999px; background: rgb(255 255 255 / 78%); font-size: .82rem; font-weight: 800; }
  .hero-art { position: relative; display: grid; min-height: 16rem; place-items: center; border: 1px solid rgb(61 107 36 / 10%); border-radius: 2rem; background: rgb(255 255 255 / 72%); }.hero-art img { width: min(70%, 15rem); height: auto; object-fit: contain; }.floating { position: absolute; display: grid; width: 3.3rem; height: 3.3rem; place-items: center; border-radius: 1rem; background: white; box-shadow: var(--shadow-soft); font-size: 1.6rem; }.f1 { top: 1.2rem; left: 1.1rem; transform: rotate(-9deg); }.f2 { right: 1rem; top: 2.5rem; transform: rotate(8deg); }.f3 { right: 2rem; bottom: 1rem; transform: rotate(-7deg); }
  .gift-section { padding-block: 3rem 4rem; background: white; }.gift-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }.gift-toolbar h2 { margin-top: .35rem; font-size: clamp(1.7rem, 3.5vw, 2.5rem); }.search { display: flex; align-items: center; gap: .6rem; width: min(100%, 19rem); min-height: 3rem; padding: .6rem .8rem; border: 1px solid var(--color-line); border-radius: .9rem; background: #fffdf8; }.search:focus-within { border-color: var(--color-leaf); }.search input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; }.search > span:first-child { color: var(--color-leaf); font-size: 1.3rem; }
  .filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.3rem; }.filter { min-height: 2.6rem; padding: .5rem .9rem; border: 1px solid var(--color-line); border-radius: 999px; background: white; color: var(--color-muted); font-weight: 800; cursor: pointer; }.filter.is-active { border-color: var(--color-leaf); background: var(--color-leaf); color: white; }.count { margin: 1.2rem 0; color: var(--color-muted); font-size: .88rem; }
  .gift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }.gift-card { overflow: hidden; min-width: 0; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: white; box-shadow: 0 5px 20px rgb(42 76 23 / 4%); }.gift-card[hidden] { display: none !important; }.gift-art { position: relative; display: grid; min-height: 8.5rem; place-items: center; background: linear-gradient(135deg, #fff6d9, #f1f7e8); }.gift-emoji { font-size: 3.7rem; }.gift-price { position: absolute; right: .8rem; bottom: .8rem; padding: .4rem .65rem; border-radius: .7rem; background: white; color: var(--color-leaf-dark); font-size: 1.1rem; font-weight: 900; }.gift-price small { color: var(--color-muted); font-size: .68rem; font-weight: 700; }
  .gift-content { display: flex; flex-direction: column; height: calc(100% - 8.5rem); padding: 1rem; }.budget-label { align-self: flex-start; padding: .25rem .55rem; border-radius: 999px; background: #fff0bd; color: #6b4b00; font-size: .7rem; font-weight: 900; }.gift-content h3 { margin-top: .65rem; font-size: 1.1rem; }.gift-content ul { display: grid; gap: .5rem; margin: .9rem 0 1.1rem; padding-left: 1.15rem; color: var(--color-muted); font-size: .84rem; }.gift-content li::marker { color: var(--color-leaf); }.order-button { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: auto; padding: .8rem .9rem; border-radius: .8rem; background: var(--color-leaf); color: white; font-weight: 900; font-size: .88rem; text-decoration: none; }.order-button:hover { background: var(--color-leaf-dark); }
  .empty { padding: 3rem 1rem; text-align: center; }.empty > span { font-size: 3rem; }.empty h2 { margin-top: .7rem; }.empty p { margin-top: .4rem; color: var(--color-muted); }.empty button { margin-top: 1rem; padding: .7rem 1rem; border: 0; border-radius: 999px; background: var(--color-leaf); color: white; font-weight: 800; }.note { margin-top: 2rem; padding: 1rem; border-left: 3px solid var(--color-honey); background: #fff9e8; color: var(--color-muted); font-size: .82rem; }
  .gift-steps { padding-block: 3rem; background: #f5f8ed; }.section-heading { margin-bottom: 1.4rem; }.section-heading h2 { margin-top: .4rem; font-size: clamp(1.7rem, 3.5vw, 2.5rem); }.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }.steps article { padding: 1.2rem; border: 1px solid #e3e9d9; border-radius: 1rem; background: white; }.steps article > span { color: var(--color-honey-deep); font-weight: 900; }.steps h3 { margin-top: .5rem; }.steps p { margin-top: .4rem; color: var(--color-muted); font-size: .9rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; }.hero-art { min-height: 13rem; }.hero-art img { width: 9rem; }.gift-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.steps { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .gift-toolbar { align-items: stretch; flex-direction: column; }.search { width: 100%; }.gift-grid { grid-template-columns: 1fr; }.gift-card { display: grid; grid-template-columns: minmax(5.5rem, .55fr) minmax(0, 1fr); }.gift-art { min-height: 100%; }.gift-emoji { font-size: 2.6rem; }.gift-price { right: .4rem; bottom: .4rem; left: .4rem; padding: .35rem; text-align: center; font-size: .95rem; }.gift-content { height: auto; padding: .8rem; }.gift-content h3 { font-size: 1rem; }.gift-content ul { gap: .35rem; font-size: .78rem; }.order-button { padding: .7rem; font-size: .78rem; } }
</style>
<script>
  const search = document.querySelector("#gift-search");
  const cards = Array.from(document.querySelectorAll(".gift-card"));
  const buttons = Array.from(document.querySelectorAll(".filter"));
  const count = document.querySelector("#gift-count");
  const empty = document.querySelector("#gift-empty");
  let activeFilter = "all";
  function updateGifts() {
    const query = (search?.value ?? "").trim().toLocaleLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matchesCategory = activeFilter === "all" || card.dataset.category === activeFilter;
      const matchesSearch = (card.dataset.search ?? "").includes(query);
      const show = matchesCategory && matchesSearch;
      card.hidden = !show;
      if (show) visible += 1;
    }
    if (count) count.textContent = `Showing ${visible} of ${cards.length} gift packs`;
    if (empty) empty.hidden = visible > 0;
  }
  search?.addEventListener("input", updateGifts);
  buttons.forEach((button) => button.addEventListener("click", () => {
    activeFilter = button.dataset.filter ?? "all";
    buttons.forEach((item) => {
      const selected = item === button;
      item.classList.toggle("is-active", selected);
      item.setAttribute("aria-pressed", String(selected));
    });
    updateGifts();
  }));
  document.querySelector("#gift-reset")?.addEventListener("click", () => {
    if (search) search.value = "";
    activeFilter = "all";
    buttons.forEach((button) => {
      const selected = button.dataset.filter === "all";
      button.classList.toggle("is-active", selected);
      button.setAttribute("aria-pressed", String(selected));
    });
    updateGifts();
    search?.focus();
  });
</script>
