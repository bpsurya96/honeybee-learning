---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "All Products — HoneyBee Learning | Personalised Activity Books & Gifts";
const description = "Browse all personalised activity books, reusable learning products, and birthday return gift combos from HoneyBee Learning. Filter by category, search themes, and order in minutes.";
const canonicalUrl = "https://honeybeelearning.co.in/products.html";
const activeNav = "products.html";
const extraStylesheets = [];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <meta name="keywords" content="all products honeybee learning, personalised activity books, reusable learning books, kids return gifts, product filters, search products">
    <meta name="robots" content="index, follow">
  </Fragment>


  
  <div class="nav-drawer-overlay" id="navOverlay"></div>

  <main class="section-block" style="padding-top: 110px; padding-bottom: 60px;">
    <section class="section-headline" style="text-align:center; max-width:960px; margin:0 auto 38px;">
      <div class="section-tag">All Products</div>
      <h1 style="font-size:2.25rem; line-height:1.1; margin:14px 0 12px;">Browse Every Product in One Place</h1>
      <p style="font-size:1rem; color:var(--text-soft); max-width:760px; margin:0 auto;">Search by theme, filter by age and book type, and shop personalised activity books, reusable write-and-wipe products, flashcards, and birthday return gifts with ease.</p>
    </section>

    <div class="search-container reveal" style="max-width:940px; margin:0 auto 24px;">
      <span class="search-icon">🔍</span>
      <input type="text" id="productSearch" class="search-input" placeholder="Search for themes, ages, products or keywords..." oninput="handleSearch(this.value)">
    </div>

    <div class="product-filter-row" style="max-width:940px; margin:0 auto 26px; padding:0 12px; display:grid; grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); gap:12px;">
      <label style="display:flex; flex-direction:column; gap:8px; font-weight:700; font-size:0.92rem; color:var(--brown);">
        Age group
        <select id="filterAge" onchange="handleFilterChange()" style="border:1px solid rgba(0,0,0,0.12); border-radius:14px; padding:12px 14px; font-size:0.95rem;">
          <option value="all">All Ages</option>
          <option value="1-2">1–2 years</option>
          <option value="3-5">3–5 years</option>
          <option value="6-8">6–8 years</option>
          <option value="9-12">9–12 years</option>
        </select>
      </label>
      <label style="display:flex; flex-direction:column; gap:8px; font-weight:700; font-size:0.92rem; color:var(--brown);">
        Book type
        <select id="filterType" onchange="handleFilterChange()" style="border:1px solid rgba(0,0,0,0.12); border-radius:14px; padding:12px 14px; font-size:0.95rem;">
          <option value="all">All Types</option>
          <option value="activity">Activity Books</option>
          <option value="reusable">Reusable Books</option>
          <option value="other">Others</option>
          <option value="divine">&#x1F549;&#xFE0F; Divine Stories</option>
        </select>
      </label>
    </div>

    <div class="learning-grid" id="learningGrid" style="max-width:1200px; margin:0 auto;"></div>

  </main>

  

  <script is:inline src="js/app.js"></script>
  

</BaseLayout>
