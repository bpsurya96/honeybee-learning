  <!-- 5. CLIENT-SIDE FILTERING SCRIPT -->
  <script is:inline>

    // --- Return Gifts Order Modal Logic ---
    let currentCombo = '';
    let currentPrice = '';
    let selectedCandy = 'chocolate';

    function openOrderModal(name, price, hasCandy) {
      currentCombo = name;
      currentPrice = price;
      document.getElementById('modalCombo').textContent = name;
      document.getElementById('modalComboLabel').textContent = name;
      document.getElementById('modalPrice').textContent = price;
      document.getElementById('candyGroup').style.display = hasCandy ? 'block' : 'none';
      document.getElementById('orderForm').style.display = 'block';
      document.getElementById('successScreen').style.display = 'none';
      document.getElementById('formError').style.display = 'none';
      const minDate = new Date();
      minDate.setDate(minDate.getDate() + 3);
      document.getElementById('deliveryDate').min = minDate.toISOString().split('T')[0];
      document.getElementById('modalOverlay').classList.add('open');
      document.body.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
    }

    function closeOrderModal() {
      document.getElementById('modalOverlay').classList.remove('open');
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
      setTimeout(() => {
        document.getElementById('orderForm').style.display = 'block';
        document.getElementById('successScreen').style.display = 'none';
        ['buyerName', 'buyerPhone', 'childName', 'address', 'notes'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.value = '';
        });
        document.getElementById('quantity').value = 10;
        document.getElementById('ageGroup').value = '';
        document.getElementById('deliveryDate').value = '';
        selectCandy('chocolate');
      }, 300);
    }

    function closeModalOnBg(e) {
      if (e.target === document.getElementById('modalOverlay')) closeOrderModal();
    }

    function selectCandy(type) {
      selectedCandy = type;
      document.getElementById('candy1').classList.toggle('selected', type === 'chocolate');
      document.getElementById('candy2').classList.toggle('selected', type === 'chikki');
    }

    function submitOrder() {
      const name = document.getElementById('buyerName').value.trim();
      const phone = document.getElementById('buyerPhone').value.trim();
      const child = document.getElementById('childName').value.trim();
      const qty = document.getElementById('quantity').value;
      const ddate = document.getElementById('deliveryDate').value;
      const addr = document.getElementById('address').value.trim();
      const age = document.getElementById('ageGroup').value;
      const notes = document.getElementById('notes').value.trim();
      const errEl = document.getElementById('formError');
      const showCandy = document.getElementById('candyGroup').style.display !== 'none';
      const candyMap = { chocolate: '🍫 Chocolate', chikki: '🍬 Chikki' };

      if (!name || !phone || !child || !qty || !ddate || !addr) {
        errEl.textContent = '⚠️ Please fill in all required fields marked with *';
        errEl.style.display = 'block';
        return;
      }
      if (!/^\d{10}$/.test(phone.replace(/\s/g, ''))) {
        errEl.textContent = '⚠️ Please enter a valid 10-digit phone number.';
        errEl.style.display = 'block';
        return;
      }
      errEl.style.display = 'none';

      const orderId = 'HBC' + Date.now().toString().slice(-6);
      const deliveryFmt = new Date(ddate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });


      const waText = `Hi! I'd like to place an order for Return Gifts.
*Pack:* ${currentCombo}
*Quantity:* ${qty}
*Birthday Child:* ${child}
*Age Group:* ${age || 'N/A'}
*Candy:* ${showCandy ? candyMap[selectedCandy] : 'N/A'}
*Party Date:* ${deliveryFmt}

*My Name:* ${name}
*Address:* ${addr}
${notes ? '\n*Notes:* ' + notes : ''}`;

      const waUrl = `https://wa.me/918883624873?text=${encodeURIComponent(waText)}`;
      document.getElementById('waProceedBtn').href = waUrl;

      const payload = {
        _subject: 'New Return Gift Enquiry — HoneyBee Learning',
        Pack: currentCombo,
        Price: currentPrice,
        Quantity: qty,
        BuyerName: name,
        Phone: phone,
        ChildName: child,
        AgeGroup: age,
        Candy: showCandy ? candyMap[selectedCandy] : 'N/A',
        PartyDate: deliveryFmt,
        Address: addr,
        Notes: notes
      };

      const btn = document.querySelector('.btn-submit');
      const origText = btn.innerHTML;
      btn.innerHTML = 'Sending... ⏳';
      btn.disabled = true;

      fetch('https://formsubmit.co/ajax/honeybeelearning.co@gmail.com', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      }).then(r => r.json()).then(() => {
        document.getElementById('orderIdBox').textContent = `ENQUIRY #${orderId}`;
        document.getElementById('orderForm').style.display = 'none';
        document.getElementById('successScreen').style.display = 'block';
      }).catch(() => {
        errEl.textContent = '⚠️ Network error. Please try WhatsApp directly.';
        errEl.style.display = 'block';
      }).finally(() => {
        btn.innerHTML = origText;
        btn.disabled = false;
      });
    }

    // ─── FAQ ACCORDION ───

    window.openOrderModal = openOrderModal;
    window.closeOrderModal = closeOrderModal;
    window.closeModalOnBg = closeModalOnBg;
    window.selectCandy = selectCandy;
    window.submitOrder = submitOrder;

    (function () {
      const state = {
        category: 'all',
        price: 'all',
        sort: 'featured',
        query: '',
      };

      const categorySelect = document.getElementById('categoryFilter');
      const searchInput = document.getElementById('productSearchInput');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const priceSelect = document.getElementById('priceFilter');
      const sortSelect = document.getElementById('sortFilter');
      const resetBtn = document.getElementById('resetFiltersBtn');
      const gridResultCount = document.getElementById('gridResultCount');
      const catalogLiveCount = document.getElementById('catalogLiveCount');
      const emptyState = document.getElementById('catalogEmptyState');
      const emptyStateResetBtn = document.getElementById('emptyStateResetBtn');
      const activeChipsStrip = document.getElementById('activeChipsStrip');
      const activeChipsList = document.getElementById('activeChipsList');
      const clearAllFiltersLink = document.getElementById('clearAllFiltersLink');
      const grid = document.getElementById('productsGrid');

      if (!grid) return;
      const allCards = Array.from(grid.querySelectorAll('.product-card'));

      // Check URL parameters on load
      function syncFromURL() {
        try {
          const params = new URLSearchParams(window.location.search);
          const cat = params.get('category');
          if (cat && ['all', 'customized', 'standard', 'divine-stories', 'return-gifts'].includes(cat)) {
            state.category = cat;
            if (categorySelect) categorySelect.value = cat;
          }
          const price = params.get('price');
          if (price && ['all', 'under-100', '100-300', '300-500', 'above-500'].includes(price)) {
            state.price = price;
            if (priceSelect) priceSelect.value = price;
          }
          const sort = params.get('sort');
          if (sort && ['featured', 'price-asc', 'price-desc', 'name-asc'].includes(sort)) {
            state.sort = sort;
            if (sortSelect) sortSelect.value = sort;
          }
          const q = params.get('q');
          if (q) {
            state.query = q.trim();
            if (searchInput) searchInput.value = state.query;
            if (clearSearchBtn) clearSearchBtn.style.display = 'inline-flex';
          }
        } catch (e) {
          console.warn('URL sync error:', e);
        }
      }

      function updateURL() {
        try {
          const params = new URLSearchParams();
          if (state.category !== 'all') params.set('category', state.category);
          if (state.price !== 'all') params.set('price', state.price);
          if (state.sort !== 'featured') params.set('sort', state.sort);
          if (state.query) params.set('q', state.query);
          const newUrl = params.toString()
            ? `${window.location.pathname}?${params.toString()}`
            : window.location.pathname;
          window.history.replaceState({}, '', newUrl);
        } catch (e) {
          // ignore
        }
      }

      function matchesCategory(card) {
        if (state.category === 'all') return true;
        return card.dataset.category === state.category;
      }

      function matchesPrice(card) {
        if (state.price === 'all') return true;
        const p = parseFloat(card.dataset.price) || 0;
        if (state.price === 'under-100') return p < 100;
        if (state.price === '100-300') return p >= 100 && p <= 300;
        if (state.price === '300-500') return p > 300 && p <= 500;
        if (state.price === 'above-500') return p > 500;
        return true;
      }

      function matchesSearch(card) {
        if (!state.query) return true;
        const q = state.query.toLowerCase();
        const title = card.dataset.title || '';
        const tags = card.dataset.tags || '';
        const desc = card.dataset.desc || '';
        return title.includes(q) || tags.includes(q) || desc.includes(q);
      }

      function applySort(cards) {
        if (state.sort === 'featured') {
          return cards;
        }
        return [...cards].sort((a, b) => {
          const priceA = parseFloat(a.dataset.price) || 0;
          const priceB = parseFloat(b.dataset.price) || 0;
          const titleA = a.dataset.title || '';
          const titleB = b.dataset.title || '';
          if (state.sort === 'price-asc') return priceA - priceB;
          if (state.sort === 'price-desc') return priceB - priceA;
          if (state.sort === 'name-asc') return titleA.localeCompare(titleB);
          return 0;
        });
      }

      function renderActiveChips() {
        if (!activeChipsStrip || !activeChipsList) return;
        const chips = [];

        if (state.category !== 'all') {
          const catLabels = {
            customized: 'Customized',
            standard: 'Standard',
            'divine-stories': 'Divine Stories',
            'return-gifts': 'Return Gifts',
          };
          chips.push({
            type: 'category',
            label: `Category: ${catLabels[state.category] || state.category}`,
          });
        }

        if (state.price !== 'all') {
          const priceLabels = {
            'under-100': 'Under \u20B9100',
            '100-300': '\u20B9100 \u2013 \u20B9300',
            '300-500': '\u20B9300 \u2013 \u20B9500',
            'above-500': 'Above \u20B9500',
          };
          chips.push({
            type: 'price',
            label: `Price: ${priceLabels[state.price] || state.price}`,
          });
        }

        if (state.query) {
          chips.push({
            type: 'query',
            label: `Search: "${state.query}"`,
          });
        }

        if (chips.length > 0) {
          activeChipsStrip.style.display = 'flex';
          activeChipsList.innerHTML = chips
            .map(
              (c) => `
              <span class="filter-chip">
                ${c.label}
                <button type="button" class="filter-chip-remove" data-type="${c.type}" aria-label="Remove filter">&#10005;</button>
              </span>
            `
            )
            .join('');
        } else {
          activeChipsStrip.style.display = 'none';
          activeChipsList.innerHTML = '';
        }
      }

      function applyFilters() {
        const visibleCards = [];
        allCards.forEach((card) => {
          const isVisible = matchesCategory(card) && matchesPrice(card) && matchesSearch(card);
          card.style.display = isVisible ? '' : 'none';
          if (isVisible) visibleCards.push(card);
        });

        const sorted = applySort(visibleCards);
        sorted.forEach((card) => grid.appendChild(card));

        const count = visibleCards.length;
        if (gridResultCount) {
          gridResultCount.innerHTML = `Showing <strong>${count}</strong> of ${allCards.length} products`;
        }
        if (catalogLiveCount) {
          catalogLiveCount.textContent = `${count} Products`;
        }

        if (emptyState) {
          emptyState.style.display = count === 0 ? 'block' : 'none';
        }

        renderActiveChips();
        updateURL();
      }

      function resetAll() {
        state.category = 'all';
        state.price = 'all';
        state.sort = 'featured';
        state.query = '';

        if (categorySelect) categorySelect.value = 'all';
        if (searchInput) searchInput.value = '';
        if (clearSearchBtn) clearSearchBtn.style.display = 'none';
        if (priceSelect) priceSelect.value = 'all';
        if (sortSelect) sortSelect.value = 'featured';

        applyFilters();
      }

      // Event listeners
      if (categorySelect) {
        categorySelect.addEventListener('change', (e) => {
          state.category = e.target.value;
          applyFilters();
        });
      }

      if (searchInput) {
        let debounceTimer;
        searchInput.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            state.query = e.target.value.trim();
            if (clearSearchBtn) {
              clearSearchBtn.style.display = state.query ? 'inline-flex' : 'none';
            }
            applyFilters();
          }, 200);
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          state.query = '';
          if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
          }
          clearSearchBtn.style.display = 'none';
          applyFilters();
        });
      }

      if (priceSelect) {
        priceSelect.addEventListener('change', (e) => {
          state.price = e.target.value;
          applyFilters();
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          state.sort = e.target.value;
          applyFilters();
        });
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyStateResetBtn) emptyStateResetBtn.addEventListener('click', resetAll);
      if (clearAllFiltersLink) clearAllFiltersLink.addEventListener('click', resetAll);

      if (activeChipsList) {
        activeChipsList.addEventListener('click', (e) => {
          const btn = e.target.closest('.filter-chip-remove');
          if (!btn) return;
          const type = btn.dataset.type;
          if (type === 'category') {
            state.category = 'all';
            if (categorySelect) categorySelect.value = 'all';
          } else if (type === 'price') {
            state.price = 'all';
            if (priceSelect) priceSelect.value = 'all';
          } else if (type === 'query') {
            state.query = '';
            if (searchInput) searchInput.value = '';
            if (clearSearchBtn) clearSearchBtn.style.display = 'none';
          }
          applyFilters();
        });
      }

      // Initial execution
      syncFromURL();
      applyFilters();
    })();
  </script>
</BaseLayout>
