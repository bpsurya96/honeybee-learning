---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "🐝 Bee Points — HoneyBee Learning | Earn & Redeem Loyalty Rewards";
const description = "Check your HoneyBee Learning Bee Points balance! Earn 10 Bee Points for every ₹100 spent. Redeem points for free stationery, activity sheets, discounts and more.";
const canonicalUrl = "https://honeybeelearning.co/bee-points.html";
const activeNav = "bee-points.html";
const extraStylesheets = ['css/bee-points.css'];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://honeybeelearning.co/bee-points.html">
    <meta property="og:title" content="🐝 Bee Points — HoneyBee Learning Loyalty Programme">
    <meta property="og:description"
    content="Earn 10 Bee Points for every ₹100 spent. Redeem for free stationery, worksheets, discounts & more!">
    <meta property="og:image" content="https://honeybeelearning.co/images/logo/logo.png">
  </Fragment>



  <!-- NAV -->
  
  <div class="nav-drawer-overlay" id="navOverlay"></div>

  <!-- HERO -->
  <section class="bp-hero" id="home" aria-label="Bee Points hero">
    <!-- Firework decorations -->
    <span class="bp-hero-firework" aria-hidden="true">🎆</span>
    <span class="bp-hero-firework" aria-hidden="true">✨</span>
    <span class="bp-hero-firework" aria-hidden="true">🎇</span>
    <span class="bp-hero-firework" aria-hidden="true">⭐</span>

    <div class="bp-hero-content">
      <span class="bp-hero-icon" aria-hidden="true">🐝</span>
      <h1 class="bp-hero-title">🍯 Bee Points</h1>
      <p class="bp-hero-subtitle">Your HoneyBee Learning Loyalty Rewards — Earn on every order, Redeem for amazing
        gifts!</p>
      <div class="bp-hero-pills">
        <span class="bp-pill">🛍️ ₹100 spent = 10 Bee Points</span>
        <span class="bp-pill">🎁 Redeem for free gifts & discounts</span>
        <span class="bp-pill">🔥 Points never expire</span>
      </div>
    </div>
  </section>

  <!-- POINTS LOOKUP -->
  <section class="bp-lookup-section" id="check-points" aria-labelledby="lookupTitle">
    <div class="bp-lookup-card">
      <h2 class="bp-lookup-title" id="lookupTitle">Check Your Bee Points 🐝</h2>
      <p class="bp-lookup-sub">Enter your registered mobile number to see your points balance</p>

      <form id="lookupForm" onsubmit="lookupPoints(event)">
        <div class="bp-lookup-input-wrap">
          <span class="bp-lookup-icon">📱</span>
          <input type="tel" id="mobileInput" class="bp-lookup-input" placeholder="Enter 10-digit mobile number"
            maxlength="10" pattern="[0-9]{10}" inputmode="numeric" aria-label="Mobile number" required>
        </div>
        <button type="submit" class="bp-lookup-btn" id="lookupBtn">
          <span id="lookupBtnText">Check My Points 🐝</span>
        </button>
      </form>

      <p class="bp-lookup-error" id="lookupError" aria-live="polite"></p>

      <!-- Result card -->
      <div class="bp-points-result" id="pointsResult" aria-live="polite">
        <div class="bp-points-card">
          <p class="bp-customer-name">Welcome back,</p>
          <p class="bp-customer-actual-name" id="resultName">—</p>

          <div class="bp-points-display">
            <span class="bp-points-bee-icon" aria-hidden="true">🐝</span>
            <p class="bp-points-label">Your Bee Points Balance</p>
            <p class="bp-points-value" id="resultPoints">0</p>
          </div>

          <div class="bp-stats-row">
            <div class="bp-stat-box">
              <div class="bp-stat-box-value" id="resultOrders">0</div>
              <div class="bp-stat-box-label">Total Orders</div>
            </div>
            <div class="bp-stat-box">
              <div class="bp-stat-box-value" id="resultSpent">₹0</div>
              <div class="bp-stat-box-label">Total Spent</div>
            </div>
          </div>
        </div>

        <p
          style="margin-top:16px;font-size:0.84rem;color:var(--text-soft);font-weight:600;text-align:center;line-height:1.5;">
          🎉 To redeem points, simply mention your mobile number when placing your next order on WhatsApp!
        </p>
      </div>
    </div>
  </section>

  <!-- TOP 5 LEADERBOARD -->
  <section class="bp-leader-section" id="leaderboard" aria-labelledby="leaderTitle">
    <div style="text-align:center;margin-bottom:8px;">
      <div class="section-tag">🏆 Hall of Fame</div>
      <h2 class="section-title" id="leaderTitle">Top Bee Point Earners</h2>
      <p class="section-sub" style="margin:0 auto;">Our most loyal customers — who will join next? 🐝</p>
    </div>

    <div class="bp-leader-card">
      <div class="bp-leader-list" id="leaderboardList">
        <!-- Top 5 loaded by JS -->
        <div class="bp-leader-skeleton"></div>
        <div class="bp-leader-skeleton"></div>
        <div class="bp-leader-skeleton"></div>
      </div>
      <p class="bp-leader-note">
        <a href="#check-points" style="color:var(--honey);font-weight:700;">Check your own points ↑</a>
      </p>
    </div>
  </section>


  <section class="bp-how-section" aria-labelledby="howTitle">
    <div style="text-align:center;margin-bottom:8px;">
      <div class="section-tag">Simple & Sweet</div>
      <h2 class="section-title" id="howTitle">How Bee Points Work</h2>
      <p class="section-sub" style="margin:0 auto;">Earn on every purchase, save up, and redeem for amazing rewards —
        it's that simple!</p>
    </div>

    <div class="bp-how-grid">
      <div class="bp-how-card">
        <div class="bp-how-num">1</div>
        <div class="bp-how-icon">🛍️</div>
        <h3 class="bp-how-title">Place an Order</h3>
        <p class="bp-how-desc">Shop any HoneyBee Learning product — personalised books, kits, or return gifts.</p>
      </div>
      <div class="bp-how-card">
        <div class="bp-how-num">2</div>
        <div class="bp-how-icon">🐝</div>
        <h3 class="bp-how-title">Earn 10 Points / ₹100</h3>
        <p class="bp-how-desc">For every ₹100 you spend, you automatically earn 10 Bee Points on your account.</p>
      </div>
      <div class="bp-how-card">
        <div class="bp-how-num">3</div>
        <div class="bp-how-icon">🍯</div>
        <h3 class="bp-how-title">Save & Accumulate</h3>
        <p class="bp-how-desc">Your points never expire! Keep earning across multiple orders until you're ready to
          redeem.</p>
      </div>
      <div class="bp-how-card">
        <div class="bp-how-num">4</div>
        <div class="bp-how-icon">🎁</div>
        <h3 class="bp-how-title">Redeem for Rewards</h3>
        <p class="bp-how-desc">Mention your mobile on WhatsApp when ordering. We'll apply your points instantly!</p>
      </div>
    </div>
  </section>

  <!-- REDEEM TABLE -->
  <section class="bp-redeem-section" aria-labelledby="redeemTitle">
    <div style="text-align:center;margin-bottom:8px;">
      <div class="section-tag">Rewards Catalogue</div>
      <h2 class="section-title" id="redeemTitle">🎁 Redeem Your Bee Points</h2>
      <p class="section-sub" style="margin:0 auto;">The more you shop, the more you earn! Here's what you can get with
        your points.</p>
    </div>

    <div class="bp-redeem-grid" id="redeemGrid" aria-label="Redemption rewards list">
      <!-- Populated by JS -->
    </div>

    <p style="text-align:center;margin-top:28px;font-size:0.9rem;color:var(--text-soft);font-weight:600;">
      💬 To redeem, simply mention your Bee Points when placing your order via WhatsApp!<br>
      <a href="https://wa.me/918883624873?text=Hi%20HoneyBee%20Learning!%20I%20want%20to%20redeem%20my%20Bee%20Points."
        target="_blank" rel="noopener" style="color:var(--green);font-weight:800;text-decoration:none;">Chat on WhatsApp
        →</a>
    </p>
  </section>

  <!-- CTA -->
  <section class="bp-cta-section" aria-labelledby="ctaTitle">
    <h2 class="bp-cta-title" id="ctaTitle">🐝 Start Earning Today!</h2>
    <p class="bp-cta-sub">Every order gets you closer to amazing free rewards. Browse our products and start collecting
      Bee Points!</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="products.html" class="bp-cta-btn">
        🛍️ Browse Products &amp; Earn Points
      </a>
    </div>
    <p style="margin-top:16px;font-size:0.85rem;color:rgba(255,255,255,0.45);font-weight:600;">Then WhatsApp us to place
      your order &amp; get Bee Points credited 👌</p>
  </section>

  <!-- FOOTER -->
  

  <!-- STICKY MOBILE BEE POINTS ORDER BAR (shows only on mobile) -->
  <a class="bp-mobile-wa-bar"
    href="https://wa.me/918883624873?text=Hi!%20I%20want%20to%20place%20an%20order%20%F0%9F%90%9D%20Please%20help%20me%20earn%20Bee%20Points!"
    target="_blank" rel="noopener" aria-label="Order on WhatsApp and earn Bee Points">
    <span>🐝 Order &amp; Earn Bee Points on WhatsApp</span>
  </a>

  <!-- Sticky WhatsApp -->
  

  <!-- Hamburger + Close Menu -->
  

  <!-- Supabase CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline src="js/bee-points.js"></script>


</BaseLayout>
