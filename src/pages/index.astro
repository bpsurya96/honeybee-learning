---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "HoneyBee Learning — India's First Personalised Activity Book for Kids &amp; Birthday Return Gifts, Chennai";
const description = "HoneyBee Learning is India";
const canonicalUrl = "https://honeybeelearning.co/";
const activeNav = "index.html";
const extraStylesheets = ['css/splash.css'];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "HoneyBee Learning",
    "description": "India's first personalised activity book for kids — birthday return gift combos and activity books for children aged 2–12.",
    "url": "https://honeybeelearning.co",
    "logo": "https://honeybeelearning.co/images/logo/logo.png",
    "telephone": "+918883624873",
    "email": "honeybeelearning.co@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Medavakkam",
      "addressLocality": "Chennai",
      "addressRegion": "Tamil Nadu",
      "postalCode": "600100",
      "addressCountry": "IN"
    },
    "openingHours": "Mo-Sa 09:00-20:00",
    "priceRange": "₹25 - ₹500",
    "sameAs": ["https://www.instagram.com/honeybee.learning.co"]
  }
  </script>
    <meta name="keywords"
    content="personalised kids books Chennai, personalised activity books India, birthday return gifts Chennai, kids activity books Medavakkam, personalised books for kids, return gifts for birthday party, kids personalised books Tamil Nadu, birthday return gift sets, activity books for toddlers, personalised gifts for kids, honeybee learning, kids books Chennai, return gift combos, personalised birthday gifts kids, reusable books for kids, wipe and learn books, flashcards for kids, kids learning books India, birthday gift sets Chennai, India first personalised kids book brand">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Shanmugi, HoneyBee Learning">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://honeybeelearning.co/">
    <meta property="og:title" content="HoneyBee Learning — India's First Personalised Activity Book for Kids">
    <meta property="og:description"
    content="Personalised activity books &amp; birthday return gift combos for kids. Starting ₹25. Medavakkam, Chennai. Pan-India delivery.">
    <meta property="og:image" content="https://honeybeelearning.co/images/logo/logo.png">
    <meta property="og:site_name" content="HoneyBee Learning">
    <meta property="og:locale" content="en_IN">
  </Fragment>



  <!-- ═══════════════════════════════════════════
       WELCOME SPLASH — shows once per session
       ═══════════════════════════════════════════ -->
  <div class="splash" id="welcomeSplash">

    <!-- Floating hexagons background -->
    <div class="splash-hexagons" aria-hidden="true">
      <div class="hex hex1">⬡</div>
      <div class="hex hex2">⬡</div>
      <div class="hex hex3">⬡</div>
      <div class="hex hex4">⬡</div>
      <div class="hex hex5">⬡</div>
      <div class="hex hex6">⬡</div>
    </div>

    <!-- Floating emoji confetti -->
    <div class="splash-confetti" aria-hidden="true">
      <span style="--d:0.1s;--x:12%">📚</span>
      <span style="--d:0.4s;--x:28%">⭐</span>
      <span style="--d:0.2s;--x:48%">🌸</span>
      <span style="--d:0.6s;--x:65%">🎨</span>
      <span style="--d:0.3s;--x:80%">✏️</span>
      <span style="--d:0.5s;--x:92%">🎁</span>
    </div>

    <!-- Main content -->
    <div class="splash-content">
      <!-- Bee flying in -->
      <div class="splash-bee" aria-hidden="true">🐝</div>

      <!-- Logo -->
      <div class="splash-logo">
        <img src="images/logo/logo.png" alt="HoneyBee Learning" onerror="this.style.display='none'">
      </div>

      <!-- Brand name -->
      <div class="splash-brand">
        <span class="splash-honey">HoneyBee</span>
        <span class="splash-learning">Learning</span>
      </div>

      <!-- Tagline with typing feel -->
      <p class="splash-tagline">
        🍯 Making every child's name <strong>extra special</strong> ✨
      </p>

      <!-- Progress bar -->
      <div class="splash-bar-wrap">
        <div class="splash-bar" id="splashBar"></div>
      </div>

      <p class="splash-skip">Tap anywhere to enter →</p>
    </div>

  </div>

  <!-- NAV -->
  
  <div class="nav-drawer-overlay" id="navOverlay"></div>

  <!-- ═══ HERO CAROUSEL ═══ -->
  <section class="hero-carousel-section" id="home" aria-label="Hero slideshow">

    <!-- ── Slides ── -->
    <div class="hcs-track" id="hcsTrack">

      <!-- ══ SLIDE 1: Personalised Name ══ -->
      <div class="hcs-slide hcs-slide--1" data-slide="0">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide1.png" alt="Child holding a personalised activity book with their name on it"
            class="hcs-img" loading="eager">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🇮🇳 India's First — Chennai</div>
          <h1 class="hcs-headline">Your Child's Name<br><span class="hcs-accent">On Every Page!</span></h1>
          <p class="hcs-body">We print <strong>your child's name</strong> across every page of the book — making
            learning feel magical, personal and exciting. Works for kids aged 2–12!</p>
          <div class="hcs-trust-row">
            <span>✅ Personalised</span>
            <span>✅ Ages 2–12</span>
            <span>✅ 1200+ Delivered</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">See Products 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 2: 8+ Themes ══ -->
      <div class="hcs-slide hcs-slide--2" data-slide="1">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide2.png" alt="8 different themed activity books for kids" class="hcs-img"
            loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🎨 Choose Their Favourite</div>
          <h2 class="hcs-headline">15+ Fun Themes<br><span class="hcs-accent">Let Them Pick!</span></h2>
          <p class="hcs-body">From Thomas 🚂 to Spiderman 🕸️ to Unicorn 🦄 — we have every child's favourite character.
            When they love the theme, they love to learn!</p>
          <div class="hcs-theme-chips">
            <span>🚂 Thomas</span><span>🦇 Batman</span><span>🦄 Unicorn</span>
            <span>🍉 Cocomelon</span><span>🕸️ Spiderman</span><span>🦸 Hulk</span>
            <span>🧭 Dora</span><span>🚗 Cars</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">Explore Books 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 3: Wipe & Learn ══ -->
      <div class="hcs-slide hcs-slide--3" data-slide="2">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide3.png" alt="Child writing on a laminated book page and wiping it clean"
            class="hcs-img" loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">♻️ Reusable — Zero Waste</div>
          <h2 class="hcs-headline">Write, Wipe &amp;<br><span class="hcs-accent">Repeat 100+ Times!</span></h2>
          <p class="hcs-body">Every page is <strong>fully laminated</strong> — your child writes with a whiteboard
            marker, wipes it clean, and starts again. One book lasts <strong>years</strong> of daily practice!</p>
          <div class="hcs-trust-row">
            <span>✅ Fully Laminated</span>
            <span>✅ Screen-Free</span>
            <span>✅ 100+ Sessions</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">View Books 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 4: Birthday Return Gifts ══ -->
      <div class="hcs-slide hcs-slide--4" data-slide="3">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide4.png" alt="Birthday return gift sets beautifully packed" class="hcs-img"
            loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🎁 Birthday Return Gifts</div>
          <h2 class="hcs-headline">Perfect Return Gifts<br><span class="hcs-accent">Starting ₹25!</span></h2>
          <p class="hcs-body">Give something <strong>meaningful</strong> instead of plastic toys! Our birthday return
            gift combos come with personalised books, stickers &amp; candy — packed and ready for every child!</p>
          <div class="hcs-trust-row">
            <span>✅ From ₹25</span>
            <span>✅ Pan-India Delivery</span>
            <span>✅ Bulk Orders</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order Gifts
              🎁</a>
            <a href="#streams" class="hcs-btn-secondary">See Gift Combos</a>
          </div>
        </div>
      </div>

    
      <!-- ══ SLIDE 5: Divine Stories (New Series) ══ -->
      <div class="hcs-slide hcs-slide--5" data-slide="4">
        <div class="hcs-image-side" onclick="window.location.href='divine-stories.html'" style="cursor:pointer;"
          title="Explore Divine Story Books">
          <img src="images/divine_kits/Krishna/IMG20260729084104~2.jpg" alt="Personalised Divine Story Books for kids"
            class="hcs-img" loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag" style="background:#FFF6D6;color:#d97706;border-color:rgba(217,119,6,0.3);">&#x1F549;&#xFE0F; New! Divine Stories Series</div>
          <h2 class="hcs-headline">Gods Teach Values<br><span class="hcs-accent" style="color:#FF9933;">In Your Child's Name!</span></h2>
          <p class="hcs-body">Lord Krishna, Ganesha, Shiva &amp; Hanuman speak <strong>your child's name</strong> to teach friendship, bravery, kindness and devotion — starting at just <strong>&#x20B9;65</strong>!</p>
          <div class="hcs-trust-row">
            <span>&#x1FA99; Krishna, Ganesha &amp; Shiva</span>
            <span>&#x2728; Name on Every Page</span>
            <span>&#x1F4DA; From &#x20B9;65</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873?text=Hi!%20I%20would%20like%20to%20order%20Divine%20Story%20Books%20for%20my%20child" target="_blank" rel="noopener" class="hcs-btn-primary" style="background:linear-gradient(135deg,#4A0E8F,#FF9933);">Order Divine Books &#x1F4AC;</a>
            <a href="divine-stories.html" class="hcs-btn-secondary" style="border-color:#FF9933;color:#4A0E8F;text-decoration:none;">Explore Stories &#x1F549;&#xFE0F;</a>
          </div>
        </div>
      </div>

    </div><!-- /hcs-track -->

    <!-- ── Prev / Next arrows ── -->
    <button class="hcs-arrow hcs-arrow--prev" id="hcsPrev" onclick="hcsNav(-1)"
      aria-label="Previous slide">&#8249;</button>
    <button class="hcs-arrow hcs-arrow--next" id="hcsNext" onclick="hcsNav(1)" aria-label="Next slide">&#8250;</button>

    <!-- ── Slide dots ── -->
    <div class="hcs-dots" id="hcsDots" role="tablist">
      <button class="hcs-dot active" onclick="hcsGoTo(0)" role="tab" aria-label="Slide 1"></button>
      <button class="hcs-dot" onclick="hcsGoTo(1)" role="tab" aria-label="Slide 2"></button>
      <button class="hcs-dot" onclick="hcsGoTo(2)" role="tab" aria-label="Slide 3"></button>
      <button class="hcs-dot" onclick="hcsGoTo(3)" role="tab" aria-label="Slide 4"></button>
      <button class="hcs-dot" onclick="hcsGoTo(4)" role="tab" aria-label="Slide 5"></button>
    </div>

    <!-- ── Progress bar ── -->
    <div class="hcs-progress">
      <div class="hcs-progress-bar" id="hcsProgressBar"></div>
    </div>

  </section><!-- /hero-carousel-section -->

    <!-- ═══ BROWSE BY AGE NAVIGATOR ═══ -->
  <section class="age-navigator-section reveal" aria-label="Browse products by age">
    <div class="age-navigator-container">
      <div class="age-nav-header">
        <span class="age-nav-label">🎯 Fast Finder: Browse by Age</span>
      </div>
      <div class="age-nav-pills">
        <button class="age-nav-pill" onclick="quickAgeJump('0+')">
          <span class="age-nav-emoji">🍼</span>
          <span class="age-nav-text"><strong>0+ Months</strong><small>Visual Learning &amp; Divine</small></span>
        </button>
        <button class="age-nav-pill" onclick="quickAgeJump('2+')">
          <span class="age-nav-emoji">🎨</span>
          <span class="age-nav-text"><strong>2+ Years</strong><small>Writing Journey (Photo &amp; Name)</small></span>
        </button>
        <button class="age-nav-pill" onclick="quickAgeJump('3+')">
          <span class="age-nav-emoji">🧒</span>
          <span class="age-nav-text"><strong>3+ Years</strong><small>Phonics, Tamil, Charts &amp; Ocean</small></span>
        </button>
        <button class="age-nav-pill age-nav-pill--gifts" onclick="quickAgeJump('gifts')">
          <span class="age-nav-emoji">🎁</span>
          <span class="age-nav-text"><strong>Party Gifts</strong><small>Bulk Packs from ₹25</small></span>
        </button>
      </div>
    </div>
  </section>

  <!-- ═══ 3-PILLAR QUICK CATEGORY GATEWAY ═══ -->
  <section class="hero-cat-gateway" aria-label="Quick category explorer">
    <div class="hero-cat-container">
      <div class="hero-cat-intro">
        <span class="hero-cat-tagline">&#x2728; Explore HoneyBee Collections</span>
        <h2 class="hero-cat-heading">What are you looking for today?</h2>
        <p style="font-size:0.95rem; color:var(--text-soft); max-width:650px; margin:8px auto 0; font-weight:600;">
          Choose from customized keepsake books, standard curriculum essentials, or bulk party gift packs.
        </p>
      </div>
      <div class="hero-cat-grid">

        <!-- Card 1: Customised Collection -->
        <div class="hero-cat-card hero-cat-card--custom" onclick="switchStreamCategory('custom'); scrollToStreams();" tabindex="0" role="button" aria-label="Explore Customised Books">
          <div class="hero-cat-badge">&#x2728; Name &amp; Photo Personalised</div>
          <div class="hero-cat-icon-wrap">
            <span class="hero-cat-icon">&#x1F3A8;</span>
          </div>
          <div class="hero-cat-content">
            <span class="hero-cat-age-pill">Ages 0+ to 3+ Years</span>
            <h3 class="hero-cat-title">Personalised Books</h3>
            <ul class="hero-cat-feature-list">
              <li><strong>My First Writing Journey (2+)</strong> — 7 themes, custom photo &amp; family tracing</li>
              <li><strong>Ocean Explorer Combo (3+)</strong> — Sea adventure activity pack</li>
              <li><strong>Divine Values Series (0+)</strong> — Gods teach morals in child's name</li>
            </ul>
            <div class="hero-cat-meta">
              <span class="hero-cat-price">From <strong>&#x20B9;65</strong></span>
              <span class="hero-cat-cta">Explore Customised &#x2192;</span>
            </div>
          </div>
        </div>

        <!-- Card 2: Standard Learning Essentials -->
        <div class="hero-cat-card hero-cat-card--standard" onclick="switchStreamCategory('standard'); scrollToStreams();" tabindex="0" role="button" aria-label="Explore Standard Learning Books">
          <div class="hero-cat-badge hero-cat-badge--blue">&#x1F4DA; Curriculum &amp; Skills</div>
          <div class="hero-cat-icon-wrap hero-cat-icon-wrap--blue">
            <span class="hero-cat-icon">&#x1F4D6;</span>
          </div>
          <div class="hero-cat-content">
            <span class="hero-cat-age-pill">Ages 0+ to 3+ Years</span>
            <h3 class="hero-cat-title">Standard Books &amp; Charts</h3>
            <ul class="hero-cat-feature-list">
              <li><strong>Visual Learning (0+)</strong> — High-contrast sensory book for infants</li>
              <li><strong>Phonics Level 1 &amp; 2 (3+)</strong> — Letter sounds &amp; sentence reading</li>
              <li><strong>Tamil Normal &amp; Reusable (3+)</strong> — Handwriting &amp; vowels</li>
              <li><strong>Laminated Charts &amp; Tables</strong> — English, Tamil, Hindi, Maths</li>
            </ul>
            <div class="hero-cat-meta">
              <span class="hero-cat-price">From <strong>&#x20B9;40</strong></span>
              <span class="hero-cat-cta">Explore Standard &#x2192;</span>
            </div>
          </div>
        </div>

        <!-- Card 3: Birthday Return Gifts -->
        <div class="hero-cat-card hero-cat-card--gifts" onclick="switchStreamCategory('gifts'); scrollToStreams();" tabindex="0" role="button" aria-label="Explore Birthday Return Gifts">
          <div class="hero-cat-badge hero-cat-badge--orange">&#x1F389; Party Hit · Pan-India</div>
          <div class="hero-cat-icon-wrap hero-cat-icon-wrap--orange">
            <span class="hero-cat-icon">&#x1F381;</span>
          </div>
          <div class="hero-cat-content">
            <span class="hero-cat-age-pill">All Birthday Parties</span>
            <h3 class="hero-cat-title">Birthday Return Gift Packs</h3>
            <ul class="hero-cat-feature-list">
              <li><strong>12 educational combos</strong> starting from &#x20B9;25</li>
              <li><strong>Personalised name card</strong> included in every pack</li>
              <li>Activity sheet + stationery / chocolate options</li>
              <li>Ready-to-gift packaging delivered across India</li>
            </ul>
            <div class="hero-cat-meta">
              <span class="hero-cat-price">Starting <strong>&#x20B9;25</strong></span>
              <span class="hero-cat-cta">View Combos &#x2192;</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══ HOW IT WORKS STRIP ═══ -->
  <section class="how-it-works-strip" aria-label="How HoneyBee Learning works">
    <div class="how-strip-header">
      <div class="section-tag">Simple &amp; Fun</div>
      <div class="how-strip-title">How It Works 🐝</div>
      <div class="how-strip-sub">From choosing a theme to practising 100+ times — here's the magic!</div>
    </div>
    <div class="how-strip-grid">

      <!-- Step 1 -->
      <div class="how-strip-step">
        <div class="how-strip-icon-wrap" style="background:linear-gradient(135deg,#e8f5d8,#c8e6a0);">
          <span>🎨</span>
          <span class="how-strip-step-num">1</span>
        </div>
        <h4>Pick a Theme</h4>
        <p>Choose from 8+ favourite characters — Thomas, Batman, Unicorn, Spiderman &amp; more!</p>
      </div>

      <!-- Step 2 -->
      <div class="how-strip-step">
        <div class="how-strip-icon-wrap" style="background:linear-gradient(135deg,#fff8e1,#ffe082);">
          <span>✏️</span>
          <span class="how-strip-step-num">2</span>
        </div>
        <h4>We Personalise</h4>
        <p>Every page is printed with <strong>your child's name</strong> to make learning feel magical.</p>
      </div>

      <!-- Step 3 -->
      <div class="how-strip-step">
        <div class="how-strip-icon-wrap" style="background:linear-gradient(135deg,#e3f2fd,#90caf9);">
          <span>🖊️</span>
          <span class="how-strip-step-num">3</span>
        </div>
        <h4>Wipe &amp; Learn</h4>
        <p>Fully laminated pages — trace with any whiteboard marker, wipe clean and go again!</p>
      </div>

      <!-- Step 4 -->
      <div class="how-strip-step">
        <div class="how-strip-icon-wrap" style="background:linear-gradient(135deg,#fce4ec,#f48fb1);">
          <span>♻️</span>
          <span class="how-strip-step-num">4</span>
        </div>
        <h4>Repeat 100+ Times</h4>
        <p>Zero paper waste — the book lasts <strong>years</strong> of daily practice. Screen-free, mess-free!</p>
      </div>

    </div>
  </section>

  <!-- BANNER STRIP -->
  <div class="banner-strip">
    <div class="banner-track">
      <div class="banner-content">
        <span>🇮🇳 India's First Personalised Activity Book for Kids</span>
        <span>🎁 Return Gift Combos from ₹25</span>
        <span>🦖 Customised Dino Theme Books</span>
        <span>🌟 Bhagavad Gita & Krishna Themes</span>
        <span>🚀 Space & STEM Learning Books</span>
        <span>🦋 Butterfly Garden Nature Theme</span>
        <span>👑 Princess & Unicorn Magic Themes</span>
        <span>✍️ Every Child's Name Personalised</span>
      </div>
      <div class="banner-content" aria-hidden="true">
        <span>🇮🇳 India's First Personalised Activity Book for Kids</span>
        <span>🎁 Return Gift Combos from ₹25</span>
        <span>🦖 Customised Dino Theme Books</span>
        <span>🌟 Bhagavad Gita & Krishna Themes</span>
        <span>🚀 Space & STEM Learning Books</span>
        <span>🦋 Butterfly Garden Nature Theme</span>
        <span>👑 Princess & Unicorn Magic Themes</span>
        <span>✍️ Every Child's Name Personalised</span>
      </div>
    </div>
  </div>

  <!-- PRODUCT STREAMS -->
  <section class="streams-section" id="streams">
    <div class="section-tag">Our Products</div>
    <div class="section-title">What We Offer</div>
    <div class="section-sub">Personalised learning books for daily use, and fun birthday return gift
      combos for every budget.</div>

    <div class="search-container reveal">
      <span class="search-icon">🔍</span>
      <input type="text" id="productSearch" class="search-input" placeholder="Search for products, themes or ages..."
        oninput="handleSearch(this.value)">
    </div>

    <div class="stream-tabs-wrap">
      <div class="stream-tabs">
        <button class="stream-tab active" id="tab-custom" onclick="switchStreamCategory('custom',this)">✨ Customised Books</button>
        <button class="stream-tab" id="tab-standard" onclick="switchStreamCategory('standard',this)">📚 Standard Learning</button>
        <button class="stream-tab" id="tab-gifts" onclick="switchStreamCategory('gifts',this)">🎁 Birthday Return Gifts</button>
      </div>
      <div class="stream-tabs-fade-hint" aria-hidden="true"></div>
    </div>

    <!-- Age Filter Row -->
    <div class="stream-age-filter-row" id="streamAgeFilterRow">
