---
import BaseLayout from "../layouts/BaseLayout.astro";
import productsOther from "../../data/products_other.json";
import productsActivity from "../../data/products_activity.json";
import productsReusable from "../../data/products_reusable.json";
import productsStories from "../../data/products_stories.json";
import returnGifts from "../../data/return-gifts.json";
import reviewsData from "../../data/reviews.json";

const title = "HoneyBee Learning — India's First Personalised Activity Book for Kids & Birthday Return Gifts, Chennai";
const description = "Shop personalised learning activity books, reusable wipe & clean workbooks, divine moral stories, ocean kits, and birthday return gift combos.";
const canonicalUrl = "https://honeybeelearning.co/";
const activeNav = "index.html";
const extraStylesheets = ['css/splash.css'];

// Customised products merged (activity + reusable)
const productsCustomised = [...productsActivity, ...productsReusable];

// The 4 Ocean Kits from ocean-kits.astro
const oceanKits = [
  {
    id: "kit-starter",
    title: "Ocean Starter Learning Kit",
    price: 340,
    mrp: 500,
    badge: "Age 3–5",
    image: "images/ocean-kits/starter-kit.jpg",
    desc: "Starter ocean activities, marine animal flashcards, tracing & fun worksheets.",
    link: "https://wa.me/918883624873?text=Hi%20HoneyBee!%20I%20want%20to%20order%20the%20Ocean%20Starter%20Learning%20Kit%20(%E2%82%B9340)."
  },
  {
    id: "kit-skill",
    title: "Ocean Skill Builder Kit",
    price: 440,
    mrp: 650,
    badge: "Age 4–7",
    image: "images/ocean-kits/skill-builder-kit.jpg",
    desc: "Skill building underwater activities, coloring, mazes & early math cards.",
    link: "https://wa.me/918883624873?text=Hi%20HoneyBee!%20I%20want%20to%20order%20the%20Ocean%20Skill%20Builder%20Kit%20(%E2%82%B9440)."
  },
  {
    id: "kit-brain",
    title: "Ocean Brain Booster Kit",
    price: 600,
    mrp: 850,
    badge: "Age 5–9",
    image: "images/ocean-kits/brain-booster-kit.jpg",
    desc: "Comprehensive brain teaser puzzles, reusable tracing & ocean learning cards.",
    link: "https://wa.me/918883624873?text=Hi%20HoneyBee!%20I%20want%20to%20order%20the%20Ocean%20Brain%20Booster%20Kit%20(%E2%82%B9600)."
  },
  {
    id: "kit-genius",
    title: "Ocean Genius Puzzle Kit",
    price: 650,
    mrp: 950,
    badge: "Mega Combo",
    image: "images/ocean-kits/genius-kit.jpg",
    desc: "Full mega combo with giant floor puzzle, flashcards, activity book & ocean passport!",
    link: "https://wa.me/918883624873?text=Hi%20HoneyBee!%20I%20want%20to%20order%20the%20Ocean%20Genius%20Puzzle%20Kit%20(%E2%82%B9650)."
  }
];

// Pick 4 featured genuine reviews
const featuredReviews = (reviewsData && reviewsData.text) ? reviewsData.text.slice(0, 4) : [];

// 11 Milestone Age Guides
const ageGuides = [
  { age: 2, title: "Age 2: Toddler Basics", badge: "Age 2+", img: "images/age-guides/age-2.jpeg" },
  { age: 3, title: "Age 3: Early Pre-Writing", badge: "Age 3+", img: "images/age-guides/age-3.jpeg" },
  { age: 4, title: "Age 4: Foundation Skills", badge: "Age 4+", img: "images/age-guides/age-4.jpeg" },
  { age: 5, title: "Age 5: Early Phonics & Math", badge: "Age 5+", img: "images/age-guides/age-5.jpeg" },
  { age: 6, title: "Age 6: Sentence & Logic", badge: "Age 6+", img: "images/age-guides/age-6.jpeg" },
  { age: 7, title: "Age 7: Creative Thinking", badge: "Age 7+", img: "images/age-guides/age-7.jpeg" },
  { age: 8, title: "Age 8: Brain Teasers & Math", badge: "Age 8+", img: "images/age-guides/age-8.jpeg" },
  { age: 9, title: "Age 9: Problem Solving", badge: "Age 9+", img: "images/age-guides/age-9.jpeg" },
  { age: 10, title: "Age 10: Advanced Logic", badge: "Age 10+", img: "images/age-guides/age-10.jpeg" },
  { age: 11, title: "Age 11: Critical Thinking", badge: "Age 11+", img: "images/age-guides/age-11.jpeg" },
  { age: 12, title: "Age 12: Independent Mastery", badge: "Age 12+", img: "images/age-guides/age-12.jpeg" },
];

---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "HoneyBee Learning",
    "description": "India's first personalised activity book for kids — birthday return gift combos and activity books for children aged 2–12.",
    "url": "https://honeybeelearning.co",
    "logo": "https://honeybeelearning.co/images/logo/logo.png",
    "telephone": "+918883624873",
    "email": "honeybeelearning.co@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Medavakkam",
      "addressLocality": "Chennai",
      "addressRegion": "Tamil Nadu",
      "postalCode": "600100",
      "addressCountry": "IN"
    },
    "openingHours": "Mo-Sa 09:00-20:00",
    "priceRange": "₹39 - ₹500",
    "sameAs": ["https://www.instagram.com/honeybee.learning.co"]
  }
  </script>
    <meta name="keywords"
    content="personalised kids books Chennai, personalised activity books India, birthday return gifts Chennai, kids activity books Medavakkam, personalised books for kids, return gifts for birthday party, kids personalised books Tamil Nadu, birthday return gift sets, activity books for toddlers, personalised gifts for kids, honeybee learning, kids books Chennai, return gift combos, personalised birthday gifts kids, reusable books for kids, wipe and learn books, flashcards for kids, kids learning books India, birthday gift sets Chennai, India first personalised kids book brand">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Shanmugi, HoneyBee Learning">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://honeybeelearning.co/">
    <meta property="og:title" content="HoneyBee Learning — India's First Personalised Activity Book for Kids">
    <meta property="og:description"
    content="Personalised activity books &amp; birthday return gift combos for kids. Starting ₹39. Medavakkam, Chennai. Pan-India delivery.">
    <meta property="og:image" content="https://honeybeelearning.co/images/logo/logo.png">
    <meta property="og:site_name" content="HoneyBee Learning">
    <meta property="og:locale" content="en_IN">
  </Fragment>



  <!-- ═══════════════════════════════════════════
       WELCOME SPLASH — shows once per session
       ═══════════════════════════════════════════ -->
  <div class="splash" id="welcomeSplash">

    <!-- Floating hexagons background -->
    <div class="splash-hexagons" aria-hidden="true">
      <div class="hex hex1">⬡</div>
      <div class="hex hex2">⬡</div>
      <div class="hex hex3">⬡</div>
      <div class="hex hex4">⬡</div>
      <div class="hex hex5">⬡</div>
      <div class="hex hex6">⬡</div>
    </div>

    <!-- Floating emoji confetti -->
    <div class="splash-confetti" aria-hidden="true">
      <span style="--d:0.1s;--x:12%">📚</span>
      <span style="--d:0.4s;--x:28%">⭐</span>
      <span style="--d:0.2s;--x:48%">🌸</span>
      <span style="--d:0.6s;--x:65%">🎨</span>
      <span style="--d:0.3s;--x:80%">✏️</span>
      <span style="--d:0.5s;--x:92%">🎁</span>
    </div>

    <!-- Main content -->
    <div class="splash-content">
      <!-- Bee flying in -->
      <div class="splash-bee" aria-hidden="true">🐝</div>

      <!-- Logo -->
      <div class="splash-logo">
        <img src="images/logo/logo.png" alt="HoneyBee Learning" onerror="this.style.display='none'">
      </div>

      <!-- Brand name -->
      <div class="splash-brand">
        <span class="splash-honey">HoneyBee</span>
        <span class="splash-learning">Learning</span>
      </div>

      <!-- Tagline with typing feel -->
      <p class="splash-tagline">
        🍯 Making every child's name <strong>extra special</strong> ✨
      </p>

      <!-- Progress bar -->
      <div class="splash-bar-wrap">
        <div class="splash-bar" id="splashBar"></div>
      </div>

      <p class="splash-skip">Tap anywhere to enter →</p>
    </div>

  </div>

  <!-- NAV -->
  
  <div class="nav-drawer-overlay" id="navOverlay"></div>

  <!-- ═══ HERO CAROUSEL ═══ -->
  <section class="hero-carousel-section" id="home" aria-label="Hero slideshow">

    <!-- ── Slides ── -->
    <div class="hcs-track" id="hcsTrack">

      <!-- ══ SLIDE 1: Personalised Name ══ -->
      <div class="hcs-slide hcs-slide--1" data-slide="0">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide1.png" alt="Child holding a personalised activity book with their name on it"
            class="hcs-img" loading="eager">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🇮🇳 India's First — Chennai</div>
          <h1 class="hcs-headline">Your Child's Name<br><span class="hcs-accent">On Every Page!</span></h1>
          <p class="hcs-body">We print <strong>your child's name</strong> across every page of the book — making
            learning feel magical, personal and exciting. Works for kids aged 2–12!</p>
          <div class="hcs-trust-row">
            <span>✅ Personalised</span>
            <span>✅ Ages 2–12</span>
            <span>✅ 1200+ Delivered</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">See Products 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 2: 8+ Themes ══ -->
      <div class="hcs-slide hcs-slide--2" data-slide="1">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide2.png" alt="8 different themed activity books for kids" class="hcs-img"
            loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🎨 Choose Their Favourite</div>
          <h2 class="hcs-headline">15+ Fun Themes<br><span class="hcs-accent">Let Them Pick!</span></h2>
          <p class="hcs-body">From Thomas 🚂 to Spiderman 🕸️ to Unicorn 🦄 — we have every child's favourite character.
            When they love the theme, they love to learn!</p>
          <div class="hcs-theme-chips">
            <span>🚂 Thomas</span><span>🦇 Batman</span><span>🦄 Unicorn</span>
            <span>🍉 Cocomelon</span><span>🕸️ Spiderman</span><span>🦸 Hulk</span>
            <span>🧭 Dora</span><span>🚗 Cars</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">Explore Books 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 3: Wipe & Learn ══ -->
      <div class="hcs-slide hcs-slide--3" data-slide="2">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide3.png" alt="Child writing on a laminated book page and wiping it clean"
            class="hcs-img" loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">♻️ Reusable — Zero Waste</div>
          <h2 class="hcs-headline">Write, Wipe &amp;<br><span class="hcs-accent">Repeat 100+ Times!</span></h2>
          <p class="hcs-body">Every page is <strong>fully laminated</strong> — your child writes with a whiteboard
            marker, wipes it clean, and starts again. One book lasts <strong>years</strong> of daily practice!</p>
          <div class="hcs-trust-row">
            <span>✅ Fully Laminated</span>
            <span>✅ Screen-Free</span>
            <span>✅ 100+ Sessions</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order on
              WhatsApp 💬</a>
            <a href="#streams" class="hcs-btn-secondary">View Books 📚</a>
          </div>
        </div>
      </div>

      <!-- ══ SLIDE 4: Birthday Return Gifts ══ -->
      <div class="hcs-slide hcs-slide--4" data-slide="3">
        <div class="hcs-image-side" onclick="window.location.href='#streams'" style="cursor:pointer;"
          title="Explore Products">
          <img src="images/hero/slide4.png" alt="Birthday return gift sets beautifully packed" class="hcs-img"
            loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag">🎁 Birthday Return Gifts</div>
          <h2 class="hcs-headline">Perfect Return Gifts<br><span class="hcs-accent">Starting ₹39!</span></h2>
          <p class="hcs-body">Give something <strong>meaningful</strong> instead of plastic toys! Our birthday return
            gift combos come with personalised books, stickers &amp; candy — packed and ready for every child!</p>
          <div class="hcs-trust-row">
            <span>✅ From ₹39</span>
            <span>✅ Pan-India Delivery</span>
            <span>✅ Bulk Orders</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873" target="_blank" rel="noopener" class="hcs-btn-primary">Order Gifts
              🎁</a>
            <a href="#streams" class="hcs-btn-secondary">See Gift Combos</a>
          </div>
        </div>
      </div>

    
      <!-- ══ SLIDE 5: Divine Stories (New Series) ══ -->
      <div class="hcs-slide hcs-slide--5" data-slide="4">
        <div class="hcs-image-side" onclick="window.location.href='divine-stories.html'" style="cursor:pointer;"
          title="Explore Divine Story Books">
          <img src="images/divine_kits/Krishna/IMG20260729084104~2.jpg" alt="Personalised Divine Story Books for kids"
            class="hcs-img" loading="lazy">
        </div>
        <div class="hcs-text-side">
          <div class="hcs-tag" style="background:#FFF6D6;color:#d97706;border-color:rgba(217,119,6,0.3);">&#x1F549;&#xFE0F; New! Divine Stories Series</div>
          <h2 class="hcs-headline">Gods Teach Values<br><span class="hcs-accent" style="color:#FF9933;">In Your Child's Name!</span></h2>
          <p class="hcs-body">Lord Krishna, Ganesha, Shiva &amp; Hanuman speak <strong>your child's name</strong> to teach friendship, bravery, kindness and devotion — starting at just <strong>&#x20B9;65</strong>!</p>
          <div class="hcs-trust-row">
            <span>&#x1FA99; Krishna, Ganesha &amp; Shiva</span>
            <span>&#x2728; Name on Every Page</span>
            <span>&#x1F4DA; From &#x20B9;65</span>
          </div>
          <div class="hcs-btns">
            <a href="https://wa.me/918883624873?text=Hi!%20I%20would%20like%20to%20order%20Divine%20Story%20Books%20for%20my%20child" target="_blank" rel="noopener" class="hcs-btn-primary" style="background:linear-gradient(135deg,#4A0E8F,#FF9933);">Order Divine Books &#x1F4AC;</a>
            <a href="divine-stories.html" class="hcs-btn-secondary" style="border-color:#FF9933;color:#4A0E8F;text-decoration:none;">Explore Stories &#x1F549;&#xFE0F;</a>
          </div>
        </div>
      </div>

    </div><!-- /hcs-track -->

    <!-- ── Prev / Next arrows ── -->
    <button class="hcs-arrow hcs-arrow--prev" id="hcsPrev" onclick="hcsNav(-1)"
      aria-label="Previous slide">&#8249;</button>
    <button class="hcs-arrow hcs-arrow--next" id="hcsNext" onclick="hcsNav(1)" aria-label="Next slide">&#8250;</button>

    <!-- ── Slide dots ── -->
    <div class="hcs-dots" id="hcsDots" role="tablist">
      <button class="hcs-dot active" onclick="hcsGoTo(0)" role="tab" aria-label="Slide 1"></button>
      <button class="hcs-dot" onclick="hcsGoTo(1)" role="tab" aria-label="Slide 2"></button>
      <button class="hcs-dot" onclick="hcsGoTo(2)" role="tab" aria-label="Slide 3"></button>
      <button class="hcs-dot" onclick="hcsGoTo(3)" role="tab" aria-label="Slide 4"></button>
      <button class="hcs-dot" onclick="hcsGoTo(4)" role="tab" aria-label="Slide 5"></button>
    </div>

    <!-- ── Progress bar ── -->
    <div class="hcs-progress">
      <div class="hcs-progress-bar" id="hcsProgressBar"></div>
    </div>

  </section><!-- /hero-carousel-section -->

  <!-- ═══ WHAT ARE YOU LOOKING FOR TODAY? CARDS ═══ -->
  <section class="section-block" style="padding: 36px 20px 20px; max-width: 1320px; margin: 0 auto;" aria-label="What are you looking for today?">
    <div style="text-align: center; margin-bottom: 24px;">
      <span class="showcase-tag">✨ Quick Explorer</span>
      <h2 style="font-family: 'Fredoka One', cursive; font-size: 2rem; color: var(--text-dark, #2d3436); margin: 6px 0;">What are you looking for today?</h2>
      <p style="font-size: 0.95rem; color: var(--text-soft, #636e72); font-weight: 600;">Tap any collection below to jump directly to its products</p>
    </div>

    <div class="what-looking-grid">
      <!-- 1. Standard -->
      <a href="#showcase-standard" class="what-looking-card">
        <span class="what-looking-icon">📚</span>
        <h3 class="what-looking-title">Standard Learning</h3>
        <p class="what-looking-sub">Phonics L1 &amp; L2, Tamil books, charts &amp; tables</p>
        <span class="what-looking-cta">Explore Standard ↓</span>
      </a>

      <!-- 2. Customised -->
      <a href="#showcase-customised" class="what-looking-card">
        <span class="what-looking-icon">✨</span>
        <h3 class="what-looking-title">Customised Books</h3>
        <p class="what-looking-sub">Child's photo, name &amp; 15+ themes on every page</p>
        <span class="what-looking-cta">Explore Customised ↓</span>
      </a>

      <!-- 3. Divine Stories -->
      <a href="#showcase-divine" class="what-looking-card">
        <span class="what-looking-icon">🕉️</span>
        <h3 class="what-looking-title">Divine Stories</h3>
        <p class="what-looking-sub">Gods teach values calling your child by name</p>
        <span class="what-looking-cta">Explore Stories ↓</span>
      </a>

      <!-- 4. Ocean Kits -->
      <a href="#showcase-ocean" class="what-looking-card">
        <span class="what-looking-icon">🌊</span>
        <h3 class="what-looking-title">Ocean Kits</h3>
        <p class="what-looking-sub">4 marine adventure combos with puzzles &amp; books</p>
        <span class="what-looking-cta">Explore Kits ↓</span>
      </a>

      <!-- 5. Return Gifts -->
      <a href="#showcase-gifts" class="what-looking-card">
        <span class="what-looking-icon">🎁</span>
        <h3 class="what-looking-title">Return Gifts</h3>
        <p class="what-looking-sub">12 party combos starting ₹39 with custom name tag</p>
        <span class="what-looking-cta">Explore Gifts ↓</span>
      </a>
    </div>
  </section>


  <!-- ═══ WHAT WE OFFER GRAND TITLE ═══ -->
  <div style="text-align: center; padding: 44px 20px 10px; max-width: 1320px; margin: 0 auto;" id="what-we-offer">
    <span class="showcase-tag">Our Products</span>
    <h2 style="font-family: 'Fredoka One', cursive; font-size: 2.3rem; color: var(--green, #1a6b3c); margin: 6px 0 10px;">What We Offer</h2>
    <p style="font-size: 1rem; color: var(--text-soft, #636e72); font-weight: 600; max-width: 680px; margin: 0 auto;">
      Swipe or scroll right on each collection to explore all available products.
    </p>
  </div>


  <!-- ═══ SHOWCASE 1: STANDARD LEARNING (products_other.json) ═══ -->
  <section class="showcase-section" id="showcase-standard">
    <div class="showcase-header">
      <div class="showcase-title-wrap">
        <span class="showcase-tag">Curriculum &amp; Skills</span>
        <h3 class="showcase-title">📚 Standard Learning Books &amp; Charts</h3>
        <p class="showcase-sub">Phonics L1 &amp; L2, Tamil books, visual learning 0+, math tables &amp; reusable charts</p>
      </div>
      <div class="showcase-actions">
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-soft);">Scroll right →</span>
        <button class="showcase-nav-btn" onclick="scrollShowcase('scroller-standard', -1)" aria-label="Scroll left">‹</button>
        <button class="showcase-nav-btn" onclick="scrollShowcase('scroller-standard', 1)" aria-label="Scroll right">›</button>
      </div>
    </div>

    <div class="showcase-track-wrap">
      <div class="showcase-scroller" id="scroller-standard">
        {productsOther.map((p) => (
          <div class="showcase-card">
            <div class="scard-img-wrap">
              <span class="scard-badge">{p.badge || 'Standard'}</span>
              <img src={p.image} alt={p.title} loading="lazy" onerror="this.src='images/logo/logo.png'" />
              <div class="scard-price">₹{p.price}</div>
            </div>
            <div class="scard-body">
              <div class="scard-title">{p.title}</div>
              <div class="scard-desc">{p.shortDesc}</div>
              <a href={`product.html?id=${p.id}`} class="scard-btn">View &amp; Order 📚</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ SHOWCASE 2: CUSTOMISED BOOKS (products_activity + products_reusable) ═══ -->
  <section class="showcase-section" id="showcase-customised">
    <div class="showcase-header">
      <div class="showcase-title-wrap">
        <span class="showcase-tag" style="background: rgba(244, 162, 39, 0.12); color: #d35400;">Personalised Keepsakes</span>
        <h3 class="showcase-title">✨ Customised &amp; Personalised Books</h3>
        <p class="showcase-sub">Printed with your child's name, photo &amp; favorite themes · 100+ reusable wipe &amp; write</p>
      </div>
      <div class="showcase-actions">
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-soft);">Scroll right →</span>
        <button class="showcase-nav-btn" onclick="scrollShowcase('scroller-customised', -1)" aria-label="Scroll left">‹</button>
        <button class="showcase-nav-btn" onclick="scrollShowcase('scroller-customised', 1)" aria-label="Scroll right">›</button>
      </div>
    </div>

    <div class="showcase-track-wrap">
      <div class="showcase-scroller" id="scroller-customised">
        {productsCustomised.map((p) => (
          <div class="showcase-card">
            <div class="scard-img-wrap">
