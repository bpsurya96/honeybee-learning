---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Personalised Activity Book  HoneyBee Learning | India's First Personalised Activity Book for Kids";
const description = "HoneyBee Learning";
const canonicalUrl = "https://honeybeelearning.co/product.html";
const activeNav = "products.html";
const extraStylesheets = ['css/product.css', 'css/custom-order.css'];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <meta name="keywords"
        content="personalised kids books Chennai, personalised activity books India, kids activity books Medavakkam, personalised books for kids, honeybee learning products, India first personalised kids book">
    <meta name="robots" content="index, follow">
    <meta name="author" content="HoneyBee Learning">
    <meta property="og:type" content="product">
    <meta property="og:url" content="https://honeybeelearning.co/product.html">
    <meta property="og:title" id="ogTitle" content="Personalised Activity Book  HoneyBee Learning">
    <meta property="og:description" id="ogDesc"
        content="Personalised kids activity books with your child's name  India's first personalised activity book for kids. Based in Medavakkam, Chennai.">
    <meta property="og:image" id="ogImage" content="https://honeybeelearning.co/images/logo/logo.png">
    <meta property="og:site_name" content="HoneyBee Learning">
    <meta property="og:locale" content="en_IN">
  </Fragment>



    
  <div class="nav-drawer-overlay" id="navOverlay"></div>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            var hamburger = document.getElementById('hamburger');
            var navLinks = document.getElementById('navLinks');
            var overlay = document.getElementById('navOverlay');

            // 1. Unified close function
            function closeMenu() {
                if (navLinks) navLinks.classList.remove('open');
                if (overlay) overlay.classList.remove('open');
                if (hamburger) {
                    hamburger.classList.remove('open');
                    hamburger.setAttribute('aria-expanded', 'false');
                }
                // Reset scrolling consistently 
                document.body.classList.remove('no-scroll');
                document.body.style.overflow = '';
            }

            // 2. Hamburger toggle logic
            if (hamburger) {
                hamburger.addEventListener('click', function (e) {
                    e.stopPropagation(); // Prevents click from bubbling to body
                    var isOpen = navLinks.classList.contains('open');
                    if (isOpen) {
                        closeMenu();
                    } else {
                        navLinks.classList.add('open');
                        if (overlay) overlay.classList.add('open');
                        hamburger.classList.add('open');
                        hamburger.setAttribute('aria-expanded', 'true');
                        document.body.classList.add('no-scroll');
                        document.body.style.overflow = 'hidden';
                    }
                });
            }

            // 3. Close on overlay click
            if (overlay) {
                overlay.addEventListener('click', closeMenu);
            }

            // 4. Close menu if clicking outside of it
            document.body.addEventListener('click', function (e) {
                if (navLinks && navLinks.classList.contains('open') && !navLinks.contains(e.target) && e.target !== hamburger) {
                    closeMenu();
                }
            });

            // 5. THE FIX: Handle link clicks with a slight delay so redirection doesn't fail
            if (navLinks) {
                navLinks.addEventListener('click', function (e) {
                    e.stopPropagation();
                });

                var links = navLinks.querySelectorAll('a');
                links.forEach(function (link) {
                    link.addEventListener('click', function () {
                        setTimeout(closeMenu, 150);
                    });
                });
            }
        });
    </script>

    <div class="product-page">
        <div class="product-layout">
            <div class="product-gallery">
                <div class="gallery-main" id="galleryMain">
                    <img id="mainImg" src="" alt="">
                    <button class="gallery-nav gallery-prev" onclick="prevImg()"></button>
                    <button class="gallery-nav gallery-next" onclick="nextImg()"></button>
                </div>
                <div class="gallery-thumbs" id="thumbsContainer"></div>
                <div class="gallery-dots" id="galleryDots"></div>
            </div>
            <div class="product-info">
                <div class="product-badge" id="productBadge"></div>
                <h1 class="product-title" id="productTitle"></h1>
                <div class="price-row">
                    <span class="price-sell" id="priceSell"></span>
                </div>
                <div class="product-desc" id="productDesc"></div>
                <div class="product-tags" id="productTags"></div>
                <div class="product-freebies" id="productFreebies" style="display:none;"></div>

                <div class="ecommerce-urgency">
                    <span class="urgency-icon">?</span>
                    <div class="urgency-text">
                        <strong>High Demand!</strong> <span class="urgency-fade">Usually sells out fast</span>
                    </div>
                </div>

                <a class="order-btn" id="orderBtn" href="#" target="_blank">Send Enquiry ??</a>
                <p class="order-note">We will reach out to you and customize based on your preference.</p>
                <button id="shareBtn" class="share-btn" onclick="shareProduct()">
                    <span class="share-icon">??</span> Share this Product
                </button>
                <div class="delivery-info">
                    <span>??</span>
                    <div>Delivery charges applicable based on location  Free pickup in Medavakkam  35 days delivery 
                        No returns  all orders are personalised &amp; confirmed with you before we print</div>
                </div>
            </div>
        </div>
    </div>

    <!-- -------------------------------------------
         WHAT YOUR CHILD WILL LEARN (AGE GUIDE)
         ------------------------------------------- -->
    <div class="age-guide-wrapper" id="ageGuideWrapper">
        <h2 class="age-guide-title">What Your Child Will Learn ??</h2>
        <p class="age-guide-sub">Carefully curated activities for every milestone!</p>
        <div class="age-guide-container" style="position: relative; max-width: 1000px; margin: 0 auto;">
            <button class="age-nav age-prev" onclick="scrollAgeGuide(-1)"></button>
            <div class="age-guide-scroll">
                <img src="images/age-guides/age-2.jpeg" class="age-guide-img" alt="Age 2 Focus" loading="lazy">
                <img src="images/age-guides/age-3.jpeg" class="age-guide-img" alt="Age 3 Focus" loading="lazy">
                <img src="images/age-guides/age-4.jpeg" class="age-guide-img" alt="Age 4 Focus" loading="lazy">
                <img src="images/age-guides/age-5.jpeg" class="age-guide-img" alt="Age 5 Focus" loading="lazy">
                <img src="images/age-guides/age-6.jpeg" class="age-guide-img" alt="Age 6 Focus" loading="lazy">
                <img src="images/age-guides/age-7.jpeg" class="age-guide-img" alt="Age 7 Focus" loading="lazy">
                <img src="images/age-guides/age-8.jpeg" class="age-guide-img" alt="Age 8 Focus" loading="lazy">
                <img src="images/age-guides/age-9.jpeg" class="age-guide-img" alt="Age 9 Focus (Problem Solving)"
                    loading="lazy">
                <img src="images/age-guides/age-10.jpeg" class="age-guide-img" alt="Age 10 Focus" loading="lazy">
                <img src="images/age-guides/age-11.jpeg" class="age-guide-img" alt="Age 11 Focus" loading="lazy">
                <img src="images/age-guides/age-12.jpeg" class="age-guide-img" alt="Age 12 Focus" loading="lazy">
            </div>
            <button class="age-nav age-next" onclick="scrollAgeGuide(1)"></button>
        </div>
        <div class="swipe-indicator">? Swipe or use buttons to see more ?</div>
    </div>

    <!-- -------------------------------------------
         RELATED PRODUCTS
         ------------------------------------------- -->
    <div class="related-section">
        <h2 class="related-title">You May Also Like ??</h2>
        <div class="learning-grid" id="relatedGrid">
            <!-- Populated via JS -->
        </div>
    </div>

    <!-- -------------------------------------------
         CUSTOMISE YOUR OWN SECTION
         ------------------------------------------- -->
    <div class="custom-section" id="customiseSection">
        <div class="custom-inner">

            <!-- Header -->
            <div class="custom-header">
                <div class="custom-badge">? We Create Anything</div>
                <h2 class="custom-title">Still not fully satisfied? <br>Let's create <span>yours!</span> ??</h2>
                <p class="custom-sub">Every child is unique  so should be their book! Tell us your dream theme and
                    we'll handcraft a personalised learning book just for your little one, delivered in 35 days. ??</p>
            </div>

            <!-- Step 1: Pick a Theme -->
            <div class="custom-step">
                <div class="custom-step-label"><span class="step-num">1</span> Pick your theme <span
                        class="step-hint">(or type your own below)</span></div>
                <div class="theme-chips" id="themeChips">
                    <button class="theme-chip" onclick="selectTheme(this, 'Marvel / Avengers')">?? Marvel /
                        Avengers</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Doraemon')">?? Doraemon</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Peppa Pig')">?? Peppa Pig</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Minions')">?? Minions</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Disney Princess')">?? Disney
                        Princess</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Paw Patrol')">?? Paw Patrol</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Cars & Trucks')">?? Cars & Trucks</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Dinosaurs')">?? Dinosaurs</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Ganesh Theme')">?? Ganesh Theme</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Tamil Culture / Pongal')">?? Tamil
                        Culture</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Ramayan Theme')">?? Ramayan Theme</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Fairy Tales')">?? Fairy Tales</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Animals & Safari')">?? Animals &
                        Safari</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Super Mario')">?? Super Mario</button>
                    <button class="theme-chip" onclick="selectTheme(this, 'Frozen / Elsa')">?? Frozen / Elsa</button>
                    <button class="theme-chip custom-chip" onclick="selectTheme(this, '')">?? My Own Theme...</button>
                </div>
                <input type="text" id="customThemeInput" class="custom-input" style="display:none;margin-top:4px;"
                    placeholder="e.g. Chota Bheem, Ninja, Tamil Alphabet, Regional Festival..." />
            </div>

            <!-- Step 2: Product Type -->
            <div class="custom-step">
                <div class="custom-step-label"><span class="step-num">2</span> What type of product?</div>
                <div class="product-type-cards" id="productTypeCards">
                    <div class="pt-card"
                        onclick="selectProductType(this, 'Personalised Activity Book (A4, 50 pages, single use)')"
                        data-type="activity">
                        <div class="pt-icon">??</div>
                        <div class="pt-name">Activity Book</div>
                        <div class="pt-desc">A4  50 pages  Tracing, Colouring, Math</div>
                        <div class="pt-price">Starting ?349</div>
                    </div>
                    <div class="pt-card"
                        onclick="selectProductType(this, 'Reusable Wipe & Learn Laminated Book (A4, 100+ uses)')"
                        data-type="reusable">
                        <div class="pt-icon">??</div>
                        <div class="pt-name">Reusable Book</div>
                        <div class="pt-desc">A4  Laminated  Wipe & Learn  100+ uses</div>
                        <div class="pt-price">Starting 399</div>
                    </div>
                    <div class="pt-card" onclick="selectProductType(this, 'Reusable Alphabet Chart (A4, laminated)')"
                        data-type="chart">
                        <div class="pt-icon">??</div>
                        <div class="pt-name">Learning Chart</div>
                        <div class="pt-desc">A4  Laminated  Alphabet / Numbers</div>
                        <div class="pt-price">Starting ?69</div>
                    </div>
                    <div class="pt-card" onclick="selectProductType(this, 'Return Gift Set (combo of books + treats)')"
                        data-type="gift">
                        <div class="pt-icon">??</div>
                        <div class="pt-name">Return Gift Set</div>
                        <div class="pt-desc">Birthday combos  Bulk orders  With treats</div>
                        <div class="pt-price">Starting ?25/set</div>
                    </div>
                    <div class="pt-card" onclick="selectProductType(this, 'Not sure  need help choosing')"
                        data-type="other">
                        <div class="pt-icon">??</div>
                        <div class="pt-name">Not Sure Yet</div>
                        <div class="pt-desc">Tell us your need & we'll recommend!</div>
                        <div class="pt-price">Free advice</div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Child Details -->
            <div class="custom-step">
                <div class="custom-step-label"><span class="step-num">3</span> A little about your child</div>
                <div class="custom-form-row">
                    <div class="custom-form-group">
                        <label class="custom-label">Child's Name *</label>
                        <input type="text" id="custChildName" class="custom-input" placeholder="e.g. Arjun, Priya..." />
                    </div>
                    <div class="custom-form-group">
                        <label class="custom-label">Age Group *</label>
                        <select id="custAge" class="custom-input" onchange="updateCustomAgeImage()">
                            <option value="">Select age group</option>
                            <option value="12 years (Toddler)">12 years (Toddler)</option>
                            <option value="35 years (Preschool / LKG)">35 years (Preschool / LKG)</option>
                            <option value="6 years">6 years (Early Primary)</option>
                            <option value="7 years">7 years</option>
                            <option value="8 years">8 years</option>
                            <option value="9 years">9 years</option>
                            <option value="10-12 years">1012 years (Class 57)</option>
                        </select>
                        <div id="custAgePreview" style="display:none; margin-top:12px; text-align:center;">
                            <img id="custAgeImage" src="" alt="Age Curriculum"
                                style="max-width:100%; border-radius:12px; border:2px solid var(--green-pale);">
                        </div>
                    </div>
                </div>
                <div class="custom-form-row">
                    <div class="custom-form-group">
                        <label class="custom-label">Quantity Needed</label>
                        <select id="custQty" class="custom-input">
                            <option value="1 copy">1 copy (for my child)</option>
                            <option value="25 copies">25 copies (siblings / cousins)</option>
                            <option value="1025 copies (Return Gifts)">1025 copies (Return Gifts)</option>
                            <option value="2550 copies (Bulk)">2550 copies (Bulk)</option>
                            <option value="50+ copies (Bulk / Event)">50+ copies (Bulk / Event)</option>
                        </select>
                    </div>
                    <div class="custom-form-group">
                        <label class="custom-label">Budget Range</label>
                        <select id="custBudget" class="custom-input">
                            <option value="">Any / Not sure</option>
                            <option value="Under ?200">Under ?200</option>
                            <option value="?200?500">?200?500</option>
                            <option value="?500?1000">?500?1000</option>
                            <option value="?1000+">?1000+</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Step 4: Extra Details -->
            <div class="custom-step">
                <div class="custom-step-label"><span class="step-num">4</span> Anything special you want?</div>
                <div class="special-chips">
                    <label class="special-chip"><input type="checkbox" value="Child's name on cover" /> ??? Name on
                        cover</label>
                    <label class="special-chip"><input type="checkbox" value="Parent names inside" /> ???????? Parent
                        names inside</label>
                    <label class="special-chip"><input type="checkbox" value="Photo on cover" /> ?? Photo on
                        cover</label>
                    <label class="special-chip"><input type="checkbox" value="Specific colour theme" /> ?? Specific
                        colours</label>
                    <label class="special-chip"><input type="checkbox" value="Tamil / regional language" /> ??? Tamil /
                        Regional</label>
                    <label class="special-chip"><input type="checkbox" value="Moral values / life skills pages" /> ??
                        Moral values</label>
                    <label class="special-chip"><input type="checkbox" value="Bilingual (English + Tamil)" /> ??
                        Bilingual</label>
                    <label class="special-chip"><input type="checkbox" value="Extra tracing pages" /> ?? More
                        tracing</label>
                </div>
                <textarea id="custNotes" class="custom-input custom-textarea"
                    placeholder="Describe your vision! e.g. 'I want a Ganesh theme book with Tamil alphabet tracing, personalised for my daughter Kavya (age 4). Need 15 copies for her birthday return gifts...'"></textarea>
            </div>

            <!-- Step 5: Contact -->
            <div class="custom-step">
                <div class="custom-step-label"><span class="step-num">5</span> Your WhatsApp number</div>
                <div class="custom-form-row">
                    <div class="custom-form-group" style="flex:2">
                        <label class="custom-label">WhatsApp Number *</label>
                        <input type="tel" id="custPhone" class="custom-input" placeholder="10-digit number"
                            maxlength="10" />
                    </div>
                    <div class="custom-form-group" style="flex:1">
                        <label class="custom-label">Best time to call?</label>
                        <select id="custTime" class="custom-input">
                            <option value="Anytime">Anytime</option>
                            <option value="Morning (9am12pm)">Morning (9am12pm)</option>
                            <option value="Afternoon (12pm4pm)">Afternoon (12pm4pm)</option>
                            <option value="Evening (4pm8pm)">Evening (4pm8pm)</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Error & Submit -->
            <p id="custError" class="cust-error" style="display:none;"></p>
            <button class="cust-submit-btn" onclick="submitCustomOrder()">
                <span>?? Send Enquiry</span>

            </button>
            <p class="cust-note">We will reach out to you and customize based on your preference.  ?? Delivery in 35
                days  ?? 100% personalised</p>

        </div>
    </div>



    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox" onclick="closeLightbox()">
        <img id="lightboxImg" src="">
        <button class="lightbox-close" onclick="closeLightbox()">?</button>
    </div>

    

    <!-- STICKY WHATSAPP BUTTON -->
    

    <script is:inline src="js/product.js"></script>

    <!-- STICKY MOBILE ORDER BAR -->
    <div class="mobile-sticky-bar" id="stickyOrderBar">
        <div class="msb-info">
            <div class="msb-title" id="msbTitle"></div>
            <div class="msb-price" id="msbPrice"></div>
        </div>
        <a class="msb-btn" id="msbBtn" href="#" target="_blank">Send Enquiry ??</a>
    </div>

</BaseLayout>
