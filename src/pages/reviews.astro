    <!-- ═══ 3. SECTION 1: VERIFIED WRITTEN REVIEWS ═══ -->
    <section class="section-block" id="writtenBlock" data-section="written">
      <div class="block-header">
        <h2>💬 Verified Parent Reviews</h2>
        <p>Honest feedback from parents on reading improvements, focus, and birthday party gifts.</p>
      </div>

      <div class="text-reviews-grid" id="textReviewsGrid">
        {textReviews.map((r) => {
          const starsStr = '★'.repeat(r.stars || 5) + '☆'.repeat(5 - (r.stars || 5));
          const catClass = r.category === 'divine' || r.category === 'Divineseries' ? 'cat-pill-divine' : r.category === 'return-gift' ? 'cat-pill-return' : 'cat-pill-activity';
          const catLabel = r.category === 'divine' || r.category === 'Divineseries' ? '🪔 Divine Stories' : r.category === 'return-gift' ? '🎁 Return Gifts' : '📖 Activity Book';
          const normCat = r.category === 'divine' || r.category === 'Divineseries' ? 'divine' : r.category;
          const initial = (r.name || 'P').trim().charAt(0).toUpperCase();

          return (
            <article 
              class="rev-card review-item" 
              data-type="written" 
              data-category={normCat} 
              data-stars={r.stars || 5} 
              data-name={(r.name || '').toLowerCase()} 
              data-loc={(r.loc || '').toLowerCase()} 
              data-text={(r.text || '').toLowerCase()}
            >
              <div class="rev-card-header">
                <div class="rev-avatar" aria-hidden="true">{initial}</div>
                <div class="rev-author-details">
                  <h3 class="rev-name">{r.name}</h3>
                  <span class="rev-location">📍 {r.loc}</span>
                </div>
                <div class="rev-verified-badge" title="Verified Customer">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Verified
                </div>
              </div>

              <div class="rev-tag-row">
                <div class="rev-stars" aria-label={`${r.stars} out of 5 stars`}>{starsStr}</div>
                <span class={`rev-cat-pill ${catClass}`}>{catLabel}</span>
              </div>

              <p class="rev-text">&ldquo;{r.text}&rdquo;</p>

              <div class="rev-card-bottom">
                <span class="rev-date">🗓️ {r.date}</span>
                <span class="rev-recommend">🍯 100% Recommended</span>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ═══ 4. SECTION 2: VIDEO TESTIMONIALS ═══ -->
    <section class="section-block" id="videoBlock" data-section="videos">
