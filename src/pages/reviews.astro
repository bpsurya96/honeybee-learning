  <!-- SCRIPT FOR VIEW SWITCHING, FILTERING & VIDEO CONTROLS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      
      
        }
      }

      if (videoPlayer && playOverlay) {
        playOverlay.addEventListener('click', function (e) {
          e.stopPropagation();
          startPlayback();
        });

        videoPlayer.addEventListener('play', function () {
          if (playOverlay) playOverlay.style.display = 'none';
        });

        videoPlayer.addEventListener('pause', function () {
          if (playOverlay && !videoPlayer.seeking && !videoPlayer.ended) {
            playOverlay.style.display = 'flex';
          }
        });

        videoPlayer.addEventListener('ended', function () {
          if (playOverlay) playOverlay.style.display = 'flex';
        });

        // If local video fails to decode, fallback to Instagram embed automatically
        videoPlayer.addEventListener('error', function () {
          console.warn('Native video error, switching to Instagram embed.');
          if (btnEmbed) btnEmbed.click();
        });
      }

      // Player Mode Switcher: Native vs Instagram Embed
      if (btnNative && btnEmbed) {
        btnNative.addEventListener('click', function () {
          btnNative.classList.add('active');
          btnEmbed.classList.remove('active');
          if (videoPlayer) videoPlayer.style.display = 'block';
          if (playOverlay && videoPlayer && videoPlayer.paused) playOverlay.style.display = 'flex';
          if (iframeWrap) iframeWrap.style.display = 'none';
        });

        btnEmbed.addEventListener('click', function () {
          btnEmbed.classList.add('active');
          btnNative.classList.remove('active');
          if (videoPlayer) {
            videoPlayer.pause();
            videoPlayer.style.display = 'none';
          }
          if (playOverlay) playOverlay.style.display = 'none';
          if (iframeWrap) {
            iframeWrap.style.display = 'block';
            if (instaIframe && instaIframe.src === 'about:blank') {
              instaIframe.src = instaIframe.getAttribute('data-src');
            }
          }
        });
      }

      // ── FILTER SYSTEM WITH AUTO-PAUSE ──
      var currentView = 'all';    // 'all', 'written', 'videos', 'photos'
      var currentCat = 'all';     // 'all', 'activity', 'return-gift', 'divine'

      var mediaTabs = document.querySelectorAll('.media-tab-btn');
      var catPills = document.querySelectorAll('.cat-pill-btn');

      var reelSection = document.getElementById('reelSection');
      var writtenBlock = document.getElementById('writtenBlock');
      var videoBlock = document.getElementById('videoBlock');
      var photoBlock = document.getElementById('photoBlock');
      var emptyState = document.getElementById('emptyState');

      var textCards = document.querySelectorAll('.rev-card');
      var ytCards = document.querySelectorAll('.yt-video-card');
      var photoCards = document.querySelectorAll('.photo-item-card');

      function applyFilter() {
        var totalVisible = 0;

        // 1. Text reviews
        var visibleText = 0;
        textCards.forEach(function (c) {
          var matchCat = (currentCat === 'all' || c.dataset.category === currentCat);
          var matchView = (currentView === 'all' || currentView === 'written');
          if (matchCat && matchView) {
            c.style.display = 'flex';
            visibleText++;
            totalVisible++;
          } else {
            c.style.display = 'none';
          }
        });
        writtenBlock.style.display = (visibleText > 0) ? 'block' : 'none';

        // 2. YouTube Videos
        var visibleYt = 0;
        ytCards.forEach(function (c) {
          var matchCat = (currentCat === 'all' || c.dataset.category === currentCat);
          var matchView = (currentView === 'all' || currentView === 'videos');
          if (matchCat && matchView) {
            c.style.display = 'flex';
            visibleYt++;
            totalVisible++;
          } else {
            c.style.display = 'none';
          }
        });
        videoBlock.style.display = (visibleYt > 0) ? 'block' : 'none';

        // 3. Instagram Reel — IMPORTANT: Auto-pause when reel section is hidden!
        var matchReelCat = (currentCat === 'all' || currentCat === 'activity');
        var matchReelView = (currentView === 'all' || currentView === 'videos');
        if (matchReelCat && matchReelView) {
          reelSection.style.display = 'block';
          totalVisible++;
        } else {
          reelSection.style.display = 'none';
          // PAUSE VIDEO WHEN HIDDEN SO AUDIO DOES NOT KEEP PLAYING!
          if (videoPlayer && !videoPlayer.paused) {
            videoPlayer.pause();
          }
        }

        // 4. Photos
        var visiblePhotos = 0;
        photoCards.forEach(function (c) {
          var matchCat = (currentCat === 'all' || c.dataset.category === currentCat);
          var matchView = (currentView === 'all' || currentView === 'photos');
          if (matchCat && matchView) {
            c.style.display = 'block';
            visiblePhotos++;
            totalVisible++;
          } else {
            c.style.display = 'none';
          }
        });
        photoBlock.style.display = (visiblePhotos > 0) ? 'block' : 'none';

        // 5. Empty State
        emptyState.style.display = (totalVisible === 0) ? 'block' : 'none';
      }

      // Click on Media Tab (Tier 1)
      mediaTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          mediaTabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
          currentView = tab.dataset.view;
          applyFilter();
        });
      });

      // Click on Category Pill (Tier 2)
      catPills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          catPills.forEach(function (p) { p.classList.remove('active'); });
          pill.classList.add('active');
          currentCat = pill.dataset.cat;
          applyFilter();
        });
      });

      // FAQ accordion
      document.querySelectorAll('.faq-question-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          btn.parentElement.classList.toggle('open');
        });
      });
    });

    // Lightbox modal functions
    function openPhotoLightbox(src) {
      var modal = document.getElementById('photoLightbox');
      var img = document.getElementById('lightboxImg');
      img.src = src;
      modal.classList.add('active');
    }

    function dismissLightbox(e) {
      if (e.target.id === 'photoLightbox' || e.target.classList.contains('lightbox-dismiss')) {
        document.getElementById('photoLightbox').classList.remove('active');
      }
    }
  </script>

