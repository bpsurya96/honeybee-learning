                  <span>🔍 Zoom Photo</span>
                </div>
              </div>
              <div class="photo-caption-bar">
                <span class={`rev-cat-pill ${catClass}`}>{catLabel}</span>
                <span class="rev-stars">{starsStr}</span>
                <span class="photo-date-badge">{p.date}</span>
