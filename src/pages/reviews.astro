      <div class="yt-videos-grid" id="ytVideosGrid">
        {videoReviews.map((v) => {
          const starsStr = '★'.repeat(v.stars || 5) + '☆'.repeat(5 - (v.stars || 5));
          const catClass = v.category === 'return-gift' ? 'cat-pill-return' : 'cat-pill-activity';
          const catLabel = v.category === 'return-gift' ? '🎁 Return Gifts' : '📖 Activity Book';

          return (
            <div 
              class="yt-video-card review-item" 
              data-type="videos" 
              data-category={v.category} 
              data-stars={v.stars || 5} 
              data-name={(v.name || '').toLowerCase()} 
              data-loc={(v.loc || '').toLowerCase()} 
              data-text={(v.text || '').toLowerCase()}
            >
              <div class="yt-frame-wrap">
                <iframe 
                  src={`https://www.youtube-nocookie.com/embed/${v.youtube}?rel=0`} 
                  title={`HoneyBee Learning customer video by ${v.name}`} 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen 
                  loading="lazy">
                </iframe>
              </div>
              <div class="yt-card-body">
                <div class="yt-badge-row">
                  <span class={`rev-cat-pill ${catClass}`}>{catLabel}</span>
                  <span class="rev-stars">{starsStr}</span>
                </div>
                <h3 class="yt-parent-title">{v.name} <span class="yt-loc-span">· {v.loc}</span></h3>
                <p class="yt-quote">&ldquo;{v.text}&rdquo;</p>
