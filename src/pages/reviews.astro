          const catClass = p.category === 'divine' ? 'cat-pill-divine' : p.category === 'return-gift' ? 'cat-pill-return' : 'cat-pill-activity';
          const catLabel = p.category === 'divine' ? '🪔 Divine Stories' : p.category === 'return-gift' ? '🎁 Return Gifts' : '📖 Activity Book';
          const imgSrc = p.img.startsWith('/') ? p.img : '/' + p.img;

          return (
            <div 
              class="photo-item-card review-item" 
              data-type="photos" 
              data-category={p.category} 
              data-stars={p.stars || 5} 
              data-name="" 
              data-loc="" 
