---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Customer Reviews & Video Ratings — HoneyBee Learning (4.9★)";
const description = "Read real reviews & watch video testimonials of HoneyBee Learning personalised activity books, return gifts and divine stories. Watch reels directly on page without opening Instagram.";
const canonicalUrl = "https://honeybeelearning.co/reviews.html";
const activeNav = "reviews.html";
const extraStylesheets = ['css/pages.css'];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <style is:global>
    /* ═════════════════════════════════════════════════════════════
       REVIEWS HUB — CLEAN, AIRY, FULLY RESPONSIVE ARCHITECTURE
       ═════════════════════════════════════════════════════════════ */
    :root {
      --hb-gold: #f59e0b;
      --hb-amber: #d97706;
      --hb-brown: #78350f;
      --hb-dark: #292019;
      --hb-cream: #faf7f2;
      --hb-green: #15803d;
      --border-soft: #ede6da;
      --shadow-sm: 0 4px 16px rgba(0,0,0,0.04);
      --shadow-hover: 0 10px 28px rgba(217, 119, 6, 0.12);
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      background: var(--hb-cream);
      color: var(--hb-dark);
      font-family: 'Nunito', sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── HERO BANNER ── */
    .rev-hero-section {
      background: linear-gradient(180deg, #fff9ee 0%, #fff4df 100%);
      padding: 105px 24px 44px;
      text-align: center;
      border-bottom: 1.5px solid #fde68a;
    }

    .hero-top-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      color: var(--hb-brown);
      font-weight: 800;
      font-size: 0.92rem;
      padding: 8px 20px;
      border-radius: 50px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.14);
      border: 1px solid #fde68a;
      margin-bottom: 16px;
      max-width: 95%;
    }

    .rev-hero-title {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.85rem, 4.5vw, 2.9rem);
      color: var(--hb-brown);
      margin: 0 0 12px;
      line-height: 1.25;
      padding: 0 8px;
    }

    .rev-hero-subtitle {
      font-size: clamp(0.95rem, 2vw, 1.08rem);
      font-weight: 600;
      color: #854d0e;
      max-width: 650px;
      margin: 0 auto 30px;
      line-height: 1.6;
      padding: 0 12px;
    }

    /* ── COMPACT RATING STATS BAR ── */
    .stats-card-bar {
      max-width: 860px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 20px;
      padding: 24px 32px;
      box-shadow: 0 10px 30px rgba(120, 53, 15, 0.08);
      border: 1.5px solid #fef3c7;
      display: grid;
      grid-template-columns: 200px 1fr 220px;
      gap: 28px;
      align-items: center;
      text-align: left;
    }

    .score-number {
      font-family: 'Fredoka One', cursive;
      font-size: 3.4rem;
      color: #b45309;
      line-height: 1;
      margin-bottom: 4px;
    }

    .score-stars-row {
      color: var(--hb-gold);
      font-size: 1.3rem;
      letter-spacing: 2px;
    }

    .score-count-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #78716c;
      margin-top: 4px;
    }

    .progress-bar-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .pbar-line {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.84rem;
      font-weight: 700;
      color: #78716c;
    }

    .pbar-track {
      flex: 1;
      height: 9px;
      background: #f5f5f4;
      border-radius: 10px;
      overflow: hidden;
    }

    .pbar-fill {
      height: 100%;
      background: linear-gradient(90deg, #f59e0b, #d97706);
      border-radius: 10px;
    }

    .stats-cta-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .btn-action-primary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      text-decoration: none;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 12px 22px;
      border-radius: 50px;
      text-align: center;
      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.28);
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-action-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(217, 119, 6, 0.35);
    }

    .btn-action-wa {
      background: #25d366;
      color: white;
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      padding: 11px 20px;
      border-radius: 50px;
      text-align: center;
      transition: transform 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-action-wa:hover {
      transform: translateY(-2px);
    }

    /* ── MAIN CONTENT WRAPPER ── */
    .rev-content-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 36px 20px 80px;
    }

    /* ── UNCLUTTERED 2-TIER TAB NAVIGATION ── */
    .controls-panel {
      position: sticky;
      top: 68px;
      z-index: 95;
      background: rgba(250, 247, 242, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 14px 0 16px;
      margin-bottom: 36px;
      border-bottom: 1.5px solid var(--border-soft);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Tier 1: Media Mode Tabs */
    .media-tabs-row {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 4px 2px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .media-tabs-row::-webkit-scrollbar { display: none; }

    .media-tab-btn {
      background: #ffffff;
      border: 1.5px solid var(--border-soft);
      color: #57534e;
      padding: 11px 20px;
      border-radius: 50px;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      font-family: inherit;
      flex-shrink: 0;
    }

    .media-tab-btn:hover {
      border-color: var(--hb-gold);
      color: var(--hb-brown);
      background: #fffbeb;
      transform: translateY(-1px);
    }

    .media-tab-btn.active {
      background: var(--hb-brown);
      color: #ffffff;
      border-color: var(--hb-brown);
      box-shadow: 0 4px 14px rgba(120, 53, 15, 0.22);
    }

    .media-tab-btn .pill-counter {
      background: rgba(0,0,0,0.07);
      font-size: 0.78rem;
      padding: 2px 8px;
      border-radius: 20px;
      font-weight: 700;
    }

    .media-tab-btn.active .pill-counter {
      background: rgba(255,255,255,0.25);
      color: #ffffff;
    }

    /* Tier 2: Product Category Pills */
    .cat-filter-row {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding: 2px 2px 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .cat-filter-row::-webkit-scrollbar { display: none; }

    .cat-filter-label {
      font-size: 0.84rem;
      font-weight: 800;
      color: #78716c;
      white-space: nowrap;
      margin-right: 4px;
      flex-shrink: 0;
    }

    .cat-pill-btn {
      background: #ffffff;
      border: 1px solid #e7e5e4;
      color: #78716c;
      padding: 6px 15px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
      font-family: inherit;
      flex-shrink: 0;
    }

    .cat-pill-btn:hover {
      border-color: #f59e0b;
      color: #b45309;
      background: #fffdf5;
    }

    .cat-pill-btn.active {
      background: #fef3c7;
      color: #92400e;
      border-color: #f59e0b;
      font-weight: 800;
    }

    /* ═════════════════════════════════════════════════════════════
       INSTAGRAM REEL CARD — IN-PAGE DIRECT MP4 PLAYBACK
       ═════════════════════════════════════════════════════════════ */
    .reel-highlight-box {
      background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
      border-radius: 24px;
      padding: 36px 32px;
      color: white;
      margin-bottom: 50px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.18);
      border: 1px solid rgba(255,255,255,0.12);
    }

    .reel-highlight-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 36px;
      align-items: center;
    }

    /* Smartphone video frame */
    .smartphone-frame {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      background: #000000;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 18px 45px rgba(0,0,0,0.6);
      border: 4px solid #3f3f46;
      aspect-ratio: 9/16;
      position: relative;
    }

    .smartphone-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      background: #000;
      cursor: pointer;
    }

    .smartphone-iframe-wrap {
      width: 100%;
      height: 100%;
      display: none;
      background: #000;
    }

    .smartphone-iframe-wrap iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .phone-verified-tag {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 50px;
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1px solid rgba(255,255,255,0.2);
      pointer-events: none;
      z-index: 5;
    }

    /* Centered Glowing Play Button Overlay (doesn't block bottom controls!) */
    .reel-play-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 56px;
      background: rgba(0, 0, 0, 0.28);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s, opacity 0.2s;
      z-index: 4;
    }

    .reel-play-overlay:hover {
      background: rgba(0, 0, 0, 0.15);
    }

    .reel-big-play-btn {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border: 3px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.8), 0 8px 24px rgba(0,0,0,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      animation: pulsePlayGlow 2.4s infinite;
    }

    .reel-play-overlay:hover .reel-big-play-btn {
      transform: scale(1.1);
      box-shadow: 0 0 35px rgba(245, 158, 11, 1), 0 10px 30px rgba(0,0,0,0.5);
    }

    .reel-big-play-btn svg {
      margin-left: 4px;
    }

    @keyframes pulsePlayGlow {
      0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(245, 158, 11, 0.6); }
      50% { transform: scale(1.05); box-shadow: 0 0 32px rgba(245, 158, 11, 0.9); }
    }

    .reel-play-hint {
      margin-top: 14px;
      background: rgba(0, 0, 0, 0.75);
      color: #fef08a;
      font-weight: 800;
      font-size: 0.88rem;
      padding: 6px 16px;
      border-radius: 30px;
      border: 1px solid rgba(255,255,255,0.2);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      pointer-events: none;
    }

    /* Mode Switcher Buttons */
    .player-mode-bar {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      background: rgba(255,255,255,0.06);
      padding: 4px;
      border-radius: 30px;
      width: fit-content;
      justify-content: center;
    }

    .player-mode-btn {
      background: transparent;
      border: none;
      color: #a1a1aa;
      font-size: 0.82rem;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .player-mode-btn.active {
      background: #f59e0b;
      color: #18181b;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .reel-content-side {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .reel-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(90deg, #f09433, #dc2743, #bc1888);
      color: white;
      font-size: 0.85rem;
      font-weight: 800;
      padding: 6px 16px;
      border-radius: 50px;
      width: fit-content;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .reel-box-title {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.5rem, 2.8vw, 2.2rem);
      margin: 0;
      color: #fef08a;
      line-height: 1.3;
    }

    .reel-box-p {
      font-size: 1.05rem;
      line-height: 1.6;
      color: #e4e4e7;
      margin: 0;
    }

    .reel-points-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-top: 6px;
    }

    .point-card {
      background: rgba(255,255,255,0.08);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.88rem;
      font-weight: 700;
      color: #fef08a;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .reel-buttons-wrap {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    .btn-ig-external {
      background: linear-gradient(135deg, #f09433, #dc2743, #bc1888);
      color: white;
      padding: 12px 22px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 0.92rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(220, 39, 67, 0.35);
      transition: transform 0.2s;
    }

    .btn-ig-external:hover {
      transform: translateY(-2px);
    }

    /* ═════════════════════════════════════════════════════════════
       SECTION CARDS — SPACIOUS & DISTINCT
       ═════════════════════════════════════════════════════════════ */
    .section-block {
      background: #ffffff;
      border-radius: 24px;
      padding: 36px 32px;
      margin-bottom: 44px;
      border: 1.5px solid var(--border-soft);
      box-shadow: var(--shadow-sm);
    }

    .block-header {
      margin-bottom: 28px;
    }

    .block-header h2 {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.4rem, 2.5vw, 1.8rem);
      color: var(--hb-brown);
      margin: 0 0 6px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .block-header p {
      color: #78716c;
      font-size: 0.96rem;
      font-weight: 600;
      margin: 0;
    }

    /* ── TEXT REVIEWS GRID ── */
    .text-reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 24px;
    }

    .rev-card {
      background: #faf8f5;
      border-radius: 18px;
      padding: 22px;
      border: 1px solid var(--border-soft);
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: all 0.2s ease;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .rev-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: #fde68a;
      background: #ffffff;
    }

    .rev-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .rev-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      color: #92400e;
      font-weight: 900;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #fde68a;
      flex-shrink: 0;
    }

    .rev-author-details {
      flex: 1;
      min-width: 140px;
    }

    .rev-name {
      font-size: 1rem;
      font-weight: 800;
      color: var(--hb-dark);
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .rev-location {
      font-size: 0.8rem;
      font-weight: 600;
      color: #78716c;
      display: block;
    }

    .rev-verified-badge {
      font-size: 0.74rem;
      font-weight: 800;
      color: var(--hb-green);
      background: #dcfce7;
      padding: 4px 9px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }

    .rev-tag-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .rev-stars {
      color: var(--hb-gold);
      font-size: 1.15rem;
      letter-spacing: 1.5px;
    }

    .rev-cat-pill {
      font-size: 0.78rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .rev-text {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #374151;
      margin: 0;
      flex: 1;
    }

    .rev-card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px dashed #e7e5e4;
      font-size: 0.8rem;
      font-weight: 700;
      color: #78716c;
      flex-wrap: wrap;
      gap: 6px;
    }

    /* ── YOUTUBE VIDEO GRID ── */
    .yt-videos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 26px;
    }

    .yt-video-card {
      background: #faf8f5;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--border-soft);
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: all 0.2s ease;
    }

    .yt-video-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: #fde68a;
      background: #ffffff;
    }

    .yt-frame-wrap {
      position: relative;
      width: 100%;
      padding-top: 56.25%; /* 16:9 */
      background: #000000;
    }

    .yt-frame-wrap iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .yt-card-body {
      padding: 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .yt-badge-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }

    .yt-parent-title {
      font-size: 1.02rem;
      font-weight: 800;
      color: var(--hb-dark);
      margin: 0;
    }

    .yt-loc-span {
      font-weight: 600;
      color: #78716c;
      font-size: 0.88rem;
    }

    .yt-quote {
      font-size: 0.9rem;
      line-height: 1.5;
      color: #4b5563;
      margin: 0;
      font-style: italic;
    }

    /* ── PHOTO GALLERY GRID ── */
    .photo-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 22px;
    }

    .photo-item-card {
      background: #faf8f5;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--border-soft);
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .photo-item-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: #fde68a;
    }

    .photo-img-container {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      overflow: hidden;
      background: #f5f5f4;
    }

    .photo-img-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .photo-item-card:hover .photo-img-container img {
      transform: scale(1.05);
    }

    .photo-hover-tag {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .photo-item-card:hover .photo-hover-tag {
      opacity: 1;
    }

    .photo-hover-tag span {
      background: #ffffff;
      color: var(--hb-dark);
      font-weight: 800;
