  <!-- CLIENT-SIDE SCRIPT FOR FILTERING, NATIVE VIDEO & LIGHTBOX -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // ── 1. NATIVE VIDEO CONTROLS (DIRECT HD PLAYBACK ONLY) ──
      var videoPlayer = document.getElementById('instaReelPlayer');
      var playOverlay = document.getElementById('reelPlayOverlay');

      function startPlayback() {
        if (!videoPlayer) return;
        var promise = videoPlayer.play();
        if (promise !== undefined) {
          promise.then(function () {
            if (playOverlay) playOverlay.style.display = 'none';
          }).catch(function (err) {
            console.log('Play blocked with sound, attempting muted:', err);
            videoPlayer.muted = true;
            videoPlayer.play().then(function () {
              if (playOverlay) playOverlay.style.display = 'none';
              videoPlayer.muted = false;
            }).catch(function (e) {
              console.warn('Playback error:', e);
            });
          });
        }
      }

      if (videoPlayer && playOverlay) {
        playOverlay.addEventListener('click', function (e) {
          e.stopPropagation();
          startPlayback();
        });

        videoPlayer.addEventListener('play', function () {
          if (playOverlay) playOverlay.style.display = 'none';
        });

        videoPlayer.addEventListener('pause', function () {
          if (playOverlay && !videoPlayer.seeking && !videoPlayer.ended) {
            playOverlay.style.display = 'flex';
          }
        });

        videoPlayer.addEventListener('ended', function () {
          if (playOverlay) playOverlay.style.display = 'flex';
        });
      }

      // ── 2. UNIFIED FILTER SYSTEM (LIKE PRODUCT PAGE) ──
      var searchInput = document.getElementById('reviewSearch');
      var formatSelect = document.getElementById('formatFilter');
      var categorySelect = document.getElementById('categoryFilter');
      var ratingSelect = document.getElementById('ratingFilter');
      var resetBtn = document.getElementById('resetReviewFilters');
      var emptyResetBtn = document.getElementById('emptyStateResetBtn');
      var chipsContainer = document.getElementById('reviewFilterChips');
      var visibleCountEl = document.getElementById('visibleCount');
      var emptyState = document.getElementById('reviewEmptyState');

      var reelSection = document.getElementById('reelSection');
      var writtenBlock = document.getElementById('writtenBlock');
      var videoBlock = document.getElementById('videoBlock');
      var photoBlock = document.getElementById('photoBlock');

      var allItems = document.querySelectorAll('.review-item');

      function applyFilters() {
        var query = (searchInput.value || '').trim().toLowerCase();
        var format = formatSelect.value;
        var category = categorySelect.value;
        var rating = ratingSelect.value;

        var visibleCount = 0;
        var visibleWritten = 0;
        var visibleVideos = 0;
        var visiblePhotos = 0;

        allItems.forEach(function (el) {
          var elType = el.getAttribute('data-type');
          var elCat = el.getAttribute('data-category') || '';
          var elStars = parseInt(el.getAttribute('data-stars') || '5', 10);
          var elName = el.getAttribute('data-name') || '';
          var elLoc = el.getAttribute('data-loc') || '';
          var elText = el.getAttribute('data-text') || '';

          // 1. Format Match
          var matchFormat = (format === 'all' || elType === format);

          // 2. Category Match
          var matchCat = (category === 'all' || elCat.indexOf(category) !== -1);

          // 3. Rating Match
          var matchRating = true;
          if (rating === '5') matchRating = (elStars === 5);
          else if (rating === '4') matchRating = (elStars >= 4);

          // 4. Search Query Match
          var matchQuery = true;
          if (query) {
            matchQuery = (
              elName.indexOf(query) !== -1 ||
              elLoc.indexOf(query) !== -1 ||
              elText.indexOf(query) !== -1 ||
              elCat.indexOf(query) !== -1
            );
          }

          var isVisible = matchFormat && matchCat && matchRating && matchQuery;
          el.style.display = isVisible ? '' : 'none';

          if (isVisible) {
            visibleCount++;
            if (elType === 'written') visibleWritten++;
            else if (elType === 'videos') visibleVideos++;
            else if (elType === 'photos') visiblePhotos++;
          }
        });

        // Hide/Show section blocks
        if (writtenBlock) writtenBlock.style.display = (visibleWritten > 0) ? 'block' : 'none';
        if (videoBlock) videoBlock.style.display = (visibleVideos > 0) ? 'block' : 'none';
        if (photoBlock) photoBlock.style.display = (visiblePhotos > 0) ? 'block' : 'none';

        // Featured reel section visibility:
        if (reelSection) {
          var matchReelFormat = (format === 'all' || format === 'videos');
          var matchReelCat = (category === 'all' || category === 'activity' || category === 'divine');
          var showReel = matchReelFormat && matchReelCat && (!query || query.indexOf('reel') !== -1 || query.indexOf('video') !== -1 || query.indexOf('divine') !== -1 || query.indexOf('activity') !== -1);
          reelSection.style.display = showReel ? 'block' : 'none';

          // Auto-pause video if hidden so sound doesn't leak
          if (!showReel && videoPlayer && !videoPlayer.paused) {
            videoPlayer.pause();
          }
        }

        // Update counter
        if (visibleCountEl) visibleCountEl.textContent = visibleCount;

        // Empty state
        if (emptyState) emptyState.style.display = (visibleCount === 0) ? 'block' : 'none';

        // Render Active Filter Chips
        renderChips(query, format, category, rating);
      }

      function renderChips(query, format, category, rating) {
        if (!chipsContainer) return;
        chipsContainer.innerHTML = '';
        var chips = [];

        if (query) {
          chips.push({ label: 'Search: \"' + query + '\"', key: 'search' });
        }
        if (format !== 'all') {
          var fText = formatSelect.options[formatSelect.selectedIndex].text.split('(')[0].trim();
          chips.push({ label: fText, key: 'format' });
        }
        if (category !== 'all') {
          var cText = categorySelect.options[categorySelect.selectedIndex].text.split('(')[0].trim();
          chips.push({ label: cText, key: 'category' });
        }
        if (rating !== 'all') {
          chips.push({ label: rating + '★ & Up', key: 'rating' });
        }

        if (chips.length > 0) {
          chipsContainer.classList.add('show');
          chips.forEach(function (c) {
            var chip = document.createElement('span');
            chip.className = 'filter-chip';
            chip.innerHTML = c.label + ' <button type="button" class="filter-chip-remove" data-key="' + c.key + '" aria-label="Remove filter">&#10005;</button>';
            chipsContainer.appendChild(chip);
          });

          var clearAll = document.createElement('button');
          clearAll.type = 'button';
          clearAll.className = 'filter-clear-all';
          clearAll.textContent = 'Clear All';
          clearAll.onclick = resetFilters;
          chipsContainer.appendChild(clearAll);
        } else {
          chipsContainer.classList.remove('show');
        }
      }

      function resetFilters() {
        if (searchInput) searchInput.value = '';
        if (formatSelect) formatSelect.value = 'all';
        if (categorySelect) categorySelect.value = 'all';
        if (ratingSelect) ratingSelect.value = 'all';
        applyFilters();
      }

      // Event listeners
      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (formatSelect) formatSelect.addEventListener('change', applyFilters);
      if (categorySelect) categorySelect.addEventListener('change', applyFilters);
      if (ratingSelect) ratingSelect.addEventListener('change', applyFilters);
      if (resetBtn) resetBtn.addEventListener('click', resetFilters);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetFilters);

      // Handle chip remove clicks
      if (chipsContainer) {
        chipsContainer.addEventListener('click', function (e) {
          var btn = e.target.closest('.filter-chip-remove');
          if (!btn) return;
          var key = btn.getAttribute('data-key');
          if (key === 'search' && searchInput) searchInput.value = '';
          else if (key === 'format' && formatSelect) formatSelect.value = 'all';
          else if (key === 'category' && categorySelect) categorySelect.value = 'all';
          else if (key === 'rating' && ratingSelect) ratingSelect.value = 'all';
          applyFilters();
        });
      }

      // FAQ Accordion
      document.querySelectorAll('.faq-question-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          btn.parentElement.classList.toggle('open');
        });
      });
    });

    // ── 3. LIGHTBOX MODAL FUNCTIONS ──
    function openPhotoLightbox(src) {
      var modal = document.getElementById('photoLightbox');
      var img = document.getElementById('lightboxImg');
      if (img) img.src = src;
      if (modal) modal.classList.add('active');
      document.body.classList.add('modal-open');
    }

    function dismissLightbox(e) {
      if (e.target.id === 'photoLightbox' || e.target.classList.contains('lightbox-dismiss')) {
        var modal = document.getElementById('photoLightbox');
        if (modal) modal.classList.remove('active');
        document.body.classList.remove('modal-open');
      }
    }

    window.openPhotoLightbox = openPhotoLightbox;
    window.dismissLightbox = dismissLightbox;
  </script>

</BaseLayout>
