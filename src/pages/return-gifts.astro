---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Birthday Return Gift Packs — HoneyBee Learning | From ₹39 · Pan-India Delivery";
const description = "Shop HoneyBee Learning";
const canonicalUrl = "https://honeybeelearning.co/return-gifts.html";
const activeNav = "return-gifts.html";
const extraStylesheets: string[] = [];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  extraStylesheets={extraStylesheets}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <style is:global>
    .rg-desktop-table-wrap {
      display: block;
    }
    .rg-mobile-matrix-wrap {
      display: none;
    }

    @media (max-width: 768px) {
      .rg-desktop-table-wrap {
        display: none !important;
      }
      .rg-mobile-matrix-wrap {
        display: block !important;
        width: 100%;
        margin: 0 auto;
      }

      /* Quick filter pills above matrix */
      .rg-m-filters {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 4px 2px 14px 2px;
        margin-bottom: 8px;
        scrollbar-width: none;
      }
      .rg-m-filters::-webkit-scrollbar {
        display: none;
      }
      .rg-m-filter-btn {
        white-space: nowrap;
        background: #ffffff;
        border: 1.5px solid rgba(47, 122, 62, 0.2);
        color: var(--text, #333);
        padding: 6px 14px;
        border-radius: 50px;
        font-family: 'Nunito', sans-serif;
        font-size: 0.82rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
      }
      .rg-m-filter-btn.active {
        background: var(--green, #2f7a3e);
        color: #ffffff;
        border-color: var(--green, #2f7a3e);
        box-shadow: 0 4px 12px rgba(47, 122, 62, 0.25);
      }

      /* Table Card Container */
      .rg-m-table-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .rg-m-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Nunito', sans-serif;
        table-layout: fixed;
      }

      .rg-m-table thead th {
        background: var(--green, #2f7a3e);
        color: #ffffff;
        padding: 10px 8px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
      }

      .rg-m-table tbody tr {
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        transition: background 0.15s ease;
      }
      .rg-m-table tbody tr:last-child {
        border-bottom: none;
      }
      .rg-m-table tbody td {
        padding: 10px 8px;
        vertical-align: middle;
        font-size: 0.8rem;
        color: var(--text, #2c3e50);
      }

      /* Alternating row colors */
      .rg-m-row-col {
        background: #fffdf5;
      }
      .rg-m-row-bw {
        background: #ffffff;
      }
      .rg-m-row-premium {
        background: linear-gradient(90deg, #fffcf0, #fff7dc) !important;
      }

      /* Pack Name & Badge */
      .rg-m-pack-name {
        font-weight: 800;
        font-size: 0.82rem;
        line-height: 1.25;
        color: var(--brown, #5c3d2e);
        margin-bottom: 4px;
        display: block;
      }
      .rg-m-type-pill {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 20px;
        letter-spacing: 0.2px;
      }
      .rg-m-type-pill.bw {
        background: #eef2f5;
        color: #495057;
      }
      .rg-m-type-pill.col {
        background: #fff0d4;
        color: #d35400;
      }
      .rg-m-type-pill.prem {
        background: linear-gradient(135deg, #ffe082, #ffd54f);
        color: #6d4c00;
        font-weight: 900;
      }

      /* Format / Pages column */
      .rg-m-format {
        font-weight: 800;
        font-size: 0.78rem;
        line-height: 1.2;
        color: var(--text, #2c3e50);
      }
      .rg-m-format-sub {
        display: block;
        font-size: 0.68rem;
        color: var(--text-soft, #7f8c8d);
        font-weight: 600;
      }

      /* Goodies icon column */
      .rg-m-goodies {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        align-items: center;
        font-size: 0.95rem;
        line-height: 1.1;
      }
      .rg-m-goodies span {
        display: inline-block;
        filter: drop-shadow(0 1px 1px rgba(0,0,0,0.1));
      }

      /* Price button */
      .rg-m-price-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
        width: 100%;
        padding: 7px 4px;
        background: var(--green, #2f7a3e);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: 'Fredoka One', cursive;
        font-size: 0.88rem;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 3px 8px rgba(47, 122, 62, 0.25);
        transition: transform 0.1s ease, box-shadow 0.1s ease;
      }
      .rg-m-price-btn:active {
        transform: scale(0.96);
      }
      .rg-m-price-btn span {
        font-family: sans-serif;
        font-size: 0.9rem;
        font-weight: bold;
        margin-left: 1px;
      }
      .rg-m-price-btn-premium {
        background: linear-gradient(135deg, #d35400, #e67e22);
        box-shadow: 0 4px 12px rgba(211, 84, 0, 0.35);
      }

      /* Legend & Note */
      .rg-m-legend {
        margin-top: 14px;
        background: #ffffff;
        border-radius: 14px;
        padding: 12px 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.04);
        font-size: 0.76rem;
      }
      .rg-m-legend-title {
        font-weight: 800;
        color: var(--brown, #5c3d2e);
        margin-bottom: 6px;
        font-size: 0.8rem;
      }
      .rg-m-legend-items {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        color: var(--text, #333);
        font-weight: 700;
        margin-bottom: 8px;
      }
      .rg-leg-icon {
        font-size: 0.9rem;
        margin-right: 2px;
      }
      .rg-m-legend-note {
        font-size: 0.74rem;
        color: var(--green-dark, #205c2e);
        font-weight: 800;
        background: var(--green-pale, #e8f5e9);
        padding: 6px 10px;
        border-radius: 8px;
      }
    }
  </style>
