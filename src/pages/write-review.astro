  <script is:inline>
    // ── SURVEY STATE STORE ──
    let selectedCategory = '';
    const ratingScores = {};
    const singleChoices = {};

    const categoryTitles = {
      'reusable': '♻️ Reusable / Write-Wipe-Write Books',
      'activity': '🎨 Theme-Based Activity Books',
      'return-gift': '🎁 Personalised Return Gifts',
      'divine': '🪔 Divine Series'
    };

    // Star Labels
    const starLabels = ['', 'Poor 😞', 'Fair 😕', 'Good 🙂', 'Great 😊', 'Excellent 🥰'];

    // ── STAR RATER HANDLER ──
    function rateStar(qid, val) {
      ratingScores[qid] = val;
      const row = document.querySelector(`.star-rater-row[data-qid="${qid}"]`);
      if (!row) return;

      const btns = row.querySelectorAll('.star-btn');
      btns.forEach((btn, idx) => {
        btn.classList.toggle('lit', idx < val);
      });

      const hint = document.getElementById(`hint_${qid}`);
      if (hint) {
        hint.textContent = starLabels[val] || `${val} Stars`;
        hint.style.color = '#f59e0b';
      }
    }

    // ── SINGLE CHOICE CHIPS ──
    function pickSingleChoice(qid, element, value) {
      singleChoices[qid] = value;
      const container = document.querySelector(`.choice-chips-row[data-qid="${qid}"]`);
      if (!container) return;

      container.querySelectorAll('.choice-chip').forEach(c => c.classList.remove('selected'));
      element.classList.add('selected');
    }

    // ── CATEGORY SELECTION (STEP 2) ──
    function selectCategory(catKey, element) {
      selectedCategory = catKey;
      document.querySelectorAll('.cat-card-option').forEach(c => c.classList.remove('selected'));
      element.classList.add('selected');
      document.getElementById('err2').style.display = 'none';

      // Setup Step 3
      document.getElementById('step3Badge').textContent = `Step 3 of 4 · ${categoryTitles[catKey] || 'Product Experience'}`;
      document.getElementById('step3Title').textContent = `${categoryTitles[catKey]} Experience`;

      // Hide all category blocks and show selected
      document.querySelectorAll('.cat-feedback-block').forEach(b => b.style.display = 'none');
      const targetBlock = document.getElementById(`catBlock_${catKey}`);
      if (targetBlock) targetBlock.style.display = 'block';
    }

    // ── PROGRESS UPDATER ──
    function updateProgress(step) {
      const pct = Math.round((step / 4) * 100);
      const stepNames = ['', 'About You', 'Product Category', 'Product Feedback', 'Shopping Experience'];
      document.getElementById('progressText').textContent = `Step ${step} of 4 · ${stepNames[step] || ''}`;
      document.getElementById('progressPct').textContent = `${pct}%`;
      document.getElementById('progressFill').style.width = `${pct}%`;
    }

    // ── STEP VALIDATION ──
    function validate(step) {
      const hide = id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; };
      const show = id => { const el = document.getElementById(id); if (el) el.style.display = 'block'; };

      if (step === 1) {
        const name = document.getElementById('revName').value.trim();
        const loc = document.getElementById('revLoc').value.trim();
        if (!name || !loc) {
          show('err1');
          return false;
        }
        hide('err1');
        return true;
      }

      if (step === 2) {
        if (!selectedCategory) {
          show('err2');
          return false;
        }
        hide('err2');
        return true;
      }

      if (step === 3) {
        // Ensure at least one rating or choice is picked in the category
        let hasAnyAnswer = false;
        for (const k in ratingScores) {
          if (ratingScores[k] > 0) { hasAnyAnswer = true; break; }
        }
        if (!hasAnyAnswer) {
          for (const k in singleChoices) {
            if (singleChoices[k]) { hasAnyAnswer = true; break; }
          }
        }

        if (!hasAnyAnswer) {
          show('err3');
          return false;
        }
        hide('err3');
        return true;
      }

      if (step === 4) {
        const quote = document.getElementById('common_parent_quote').value.trim();
        if (!quote) {
          show('err4');
          return false;
        }
        hide('err4');
        return true;
      }

      return true;
    }

    // ── NAVIGATION ──
    function goNext(step) {
      if (!validate(step)) return;
      document.getElementById(`step${step}`).classList.remove('active');
      const nextStep = step + 1;
      document.getElementById(`step${nextStep}`).classList.add('active');
      updateProgress(nextStep);
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    function goBack(step) {
      document.getElementById(`step${step}`).classList.remove('active');
      const prevStep = step - 1;
      document.getElementById(`step${prevStep}`).classList.add('active');
      updateProgress(prevStep);
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    // ── SUBMISSION ──
    async function submitReview() {
      if (!validate(4)) return;

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = '⏳ Submitting Your Review...';

      // 1. Basic Details
      const name = document.getElementById('revName').value.trim();
      const loc = document.getElementById('revLoc').value.trim();
      const phone = document.getElementById('revPhone').value.trim();
      const child = document.getElementById('revChild').value.trim();

      // 2. Open-ended answers
      const catOpenKey = `q_${selectedCategory === 'return-gift' ? 'rg' : selectedCategory === 'activity' ? 'act' : selectedCategory}_open`;
      const catOpenEl = document.getElementById(catOpenKey);
      const catOpenAnswer = catOpenEl ? catOpenEl.value.trim() : '';

      const actNextThemeEl = document.getElementById('q_act_next_theme');
      const actNextTheme = actNextThemeEl ? actNextThemeEl.value.trim() : '';

      const parentQuote = document.getElementById('common_parent_quote').value.trim();
      const mediaLink = document.getElementById('revMediaLink').value.trim();

      // 3. Assemble complete payload
      const payload = {
        _subject: `⭐ HoneyBee Review from ${name} (${loc}) — [${categoryTitles[selectedCategory] || selectedCategory}]`,
        Parent_Name: name,
        Location: loc,
        WhatsApp_Phone: phone || 'Not provided',
        Child_Info: child || 'Not provided',
        Category_Reviewed: categoryTitles[selectedCategory] || selectedCategory,

        // Ratings & Choices Map
        Ratings_Summary: JSON.stringify(ratingScores, null, 2),
        Choices_Summary: JSON.stringify(singleChoices, null, 2),

        // Open feedback
        Category_Specific_Answer: catOpenAnswer || 'None',
        Child_Next_Theme_Wish: actNextTheme || 'None',
        Advice_For_Other_Parents: parentQuote,
        Media_Or_Photo_Link: mediaLink || 'None'
      };

      // Construct a clean WhatsApp forward message
      let waMsg = `*🐝 HONEYBEE LEARNING REVIEW*\n`;
      waMsg += `*Parent:* ${name} (${loc})\n`;
      if (child) waMsg += `*Child:* ${child}\n`;
      waMsg += `*Product:* ${categoryTitles[selectedCategory] || selectedCategory}\n\n`;
      waMsg += `*Review / Advice for Parents:*\n"${parentQuote}"\n\n`;
      if (catOpenAnswer) waMsg += `*What we liked most:* ${catOpenAnswer}\n`;
      if (mediaLink) waMsg += `*Photos/Media:* ${mediaLink}\n`;

      const waUrl = `https://wa.me/918883624873?text=${encodeURIComponent(waMsg)}`;
      const waBtn = document.getElementById('waForwardBtn');
      if (waBtn) waBtn.href = waUrl;

      try {
        await fetch('https://formsubmit.co/ajax/honeybeelearning.co@gmail.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
        });

        // Show Success
        document.getElementById('step4').classList.remove('active');
        document.querySelector('.progress-wrap').style.display = 'none';
        const suc = document.getElementById('successBox');
        suc.style.display = 'block';
        window.scrollTo({ top: 120, behavior: 'smooth' });

      } catch (err) {
        console.error('Submission error:', err);
        // Even if network or FormSubmit fails, allow parent to send via WhatsApp directly!
        document.getElementById('step4').classList.remove('active');
        document.querySelector('.progress-wrap').style.display = 'none';
        const suc = document.getElementById('successBox');
        suc.style.display = 'block';
        window.scrollTo({ top: 120, behavior: 'smooth' });
      }
    }
  </script>

</BaseLayout>
