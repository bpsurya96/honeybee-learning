---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Write a Review — HoneyBee Learning";
const description = "Share your experience with HoneyBee Learning personalised kids books, return gifts, and divine series. Help other parents discover screen-free learning.";
const canonicalUrl = "https://honeybeelearning.co.in/write-review.html";
const activeNav = "reviews.html";
const extraStylesheets = ['css/pages.css'];
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav={activeNav}
  hideHeader={false}
  hideFooter={false}
  hideFab={false}
>
  <Fragment slot="head">
    <style is:global>
    :root {
      --hb-gold: #f59e0b;
      --hb-amber: #d97706;
      --hb-brown: #78350f;
      --hb-dark: #292019;
      --hb-cream: #fafaf7;
      --hb-green: #15803d;
      --honey: #f4a227;
      --brown: #6b3a1f;
      --text-soft: #7a6e65;
    }

    body {
      background: #fafaf7;
      font-family: 'Nunito', sans-serif;
      color: #292524;
      margin: 0;
      padding: 0;
    }

    /* ── BREADCRUMB ── */
    .breadcrumb {
      max-width: 800px;
      margin: 0 auto;
      padding: 82px 20px 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: #8c827a;
    }
    .breadcrumb a {
      color: #8c827a;
      text-decoration: none;
    }
    .breadcrumb a:hover {
      color: var(--hb-brown);
    }

    /* ── PAGE HERO ── */
    .page-hero {
      background: linear-gradient(135deg, #f4a227 0%, #e67e22 100%);
      padding: 36px 20px 42px;
      text-align: center;
      color: white;
      border-radius: 0 0 32px 32px;
      box-shadow: 0 8px 30px rgba(244, 162, 39, 0.22);
    }

    .page-hero-emoji {
      font-size: 2.8rem;
      display: block;
      margin-bottom: 6px;
    }

    .page-hero h1 {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.8rem, 4vw, 2.7rem);
      margin: 0 0 8px;
    }

    .page-hero p {
      max-width: 620px;
      margin: 0 auto;
      font-size: clamp(0.95rem, 2vw, 1.1rem);
      font-weight: 600;
      opacity: 0.95;
    }

    /* ── PROGRESS BAR ── */
    .progress-wrap {
      max-width: 680px;
      margin: 28px auto 0;
      padding: 0 20px;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--hb-brown);
      margin-bottom: 8px;
    }

    .progress-bar-bg {
      height: 9px;
      background: #eee5d3;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #f59e0b, #15803d);
      border-radius: 10px;
      transition: width 0.35s ease;
    }

    /* ── MAIN REVIEW CARD CONTAINER ── */
    .review-card-container {
      max-width: 680px;
      margin: 20px auto 80px;
      padding: 0 16px;
    }

    .step-box {
      background: white;
      border-radius: 24px;
      padding: 34px 28px 28px;
      box-shadow: 0 12px 40px rgba(60, 40, 10, 0.08);
      border: 1.5px solid #fde68a;
      display: none;
      animation: fadeInStep 0.25s ease forwards;
    }

    .step-box.active {
      display: block;
    }

    @keyframes fadeInStep {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .step-badge {
      display: inline-block;
      font-size: 0.76rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #92400e;
      background: #fef3c7;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 10px;
    }

    .step-title {
      font-family: 'Fredoka One', cursive;
      font-size: 1.55rem;
      color: var(--hb-brown);
      margin: 0 0 6px;
      line-height: 1.3;
    }

    .step-desc {
      color: #78716c;
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 24px;
      line-height: 1.5;
    }

    /* ── INPUTS ── */
    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-size: 0.88rem;
      font-weight: 800;
      color: #44403c;
      margin-bottom: 6px;
    }

    .rev-input,
    .rev-textarea {
      width: 100%;
      padding: 13px 16px;
      border: 2px solid #e7dfd5;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.96rem;
      font-weight: 600;
      color: #292524;
      background: #ffffff;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .rev-input:focus,
    .rev-textarea:focus {
      outline: none;
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .rev-textarea {
      min-height: 95px;
      resize: vertical;
    }

    /* ── CATEGORY SELECTION CARDS (STEP 2) ── */
    .cat-cards-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }

    .cat-card-option {
      background: #ffffff;
      border: 2px solid #e7dfd5;
      border-radius: 16px;
      padding: 18px 14px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .cat-card-option:hover {
      border-color: #f59e0b;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.12);
    }

    .cat-card-option.selected {
      border-color: #78350f;
      background: #fefce8;
      box-shadow: 0 8px 20px rgba(120, 53, 15, 0.16);
    }

    .cat-card-icon {
      font-size: 2.2rem;
    }

    .cat-card-title {
      font-family: 'Fredoka One', cursive;
      font-size: 1.05rem;
      color: #292524;
      margin: 0;
    }

    .cat-card-subtitle {
      font-size: 0.78rem;
      color: #78716c;
      font-weight: 600;
      margin: 0;
    }

    /* ── QUESTION ITEM BOXES ── */
    .question-card-item {
      background: #fafaf8;
      border: 1.5px solid #ede6da;
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 16px;
      transition: border-color 0.2s;
    }

    .question-card-item:hover, .question-card-item:focus-within {
      border-color: #f59e0b;
      background: #ffffff;
    }

    .q-title {
      font-weight: 800;
      font-size: 0.94rem;
      color: #292524;
      margin: 0 0 10px;
      line-height: 1.45;
    }

    /* ── MINI STAR RATERS ── */
    .star-rater-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .star-btn {
      background: none;
      border: none;
      font-size: 1.85rem;
      color: #d6d3d1;
      cursor: pointer;
      padding: 0;
      line-height: 1;
      transition: transform 0.15s, color 0.15s;
    }

    .star-btn.lit {
      color: #f59e0b;
    }

    .star-btn:hover {
      transform: scale(1.2);
    }

    .star-score-hint {
      font-size: 0.82rem;
      font-weight: 800;
      color: #78716c;
      margin-left: 8px;
    }

    /* ── CHOICE CHIPS ── */
    .choice-chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 6px;
    }

    .choice-chip {
      background: #ffffff;
      border: 1.5px solid #e7dfd5;
      padding: 8px 14px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #57534e;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      user-select: none;
    }

    .choice-chip:hover {
      border-color: #f59e0b;
      color: #78350f;
    }

    .choice-chip.selected {
      background: #78350f;
      color: #ffffff;
      border-color: #78350f;
      box-shadow: 0 3px 10px rgba(120, 53, 15, 0.2);
    }

    /* ── NAV BUTTONS ── */
    .btn-row {
      display: flex;
      gap: 12px;
      margin-top: 24px;
    }

    .btn-back {
      flex: 1;
      padding: 13px;
      border: 2px solid #e7dfd5;
      border-radius: 50px;
      background: white;
      font-weight: 800;
      font-size: 0.95rem;
      color: #78716c;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-back:hover {
      border-color: #f59e0b;
      color: #78350f;
    }

    .btn-next {
      flex: 2;
      padding: 13px;
      background: #15803d;
      color: white;
      border: none;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(21, 128, 61, 0.25);
      transition: all 0.2s;
    }

    .btn-next:hover {
      background: #166534;
      transform: translateY(-1px);
    }

    .btn-submit {
      flex: 2;
      padding: 13px;
      background: #f59e0b;
      color: #78350f;
      border: none;
      border-radius: 50px;
      font-weight: 900;
      font-size: 1.05rem;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);
      transition: all 0.2s;
    }

    .btn-submit:hover {
      background: #fbbf24;
      transform: translateY(-1px);
    }

    /* ── ERROR MESSAGE ── */
    .err-msg {
      color: #dc2626;
      font-weight: 700;
      font-size: 0.86rem;
      margin-top: 10px;
      display: none;
    }

    /* ── SUCCESS BOX ── */
    .success-box {
      background: white;
      border-radius: 24px;
      padding: 48px 24px 36px;
      box-shadow: 0 12px 40px rgba(60, 40, 10, 0.08);
      border: 2px solid #86efac;
      text-align: center;
      display: none;
      animation: fadeInStep 0.3s ease forwards;
    }

    .success-box h2 {
      font-family: 'Fredoka One', cursive;
      color: #15803d;
      font-size: 2.2rem;
      margin: 16px 0 10px;
    }

    .success-box p {
      font-weight: 600;
      color: #57534e;
      font-size: 1rem;
      line-height: 1.6;
      max-width: 500px;
      margin: 0 auto 24px;
    }

    .wa-share-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: #25D366;
      color: #ffffff;
      padding: 14px 28px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 1.05rem;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
      transition: all 0.2s;
      margin-bottom: 14px;
    }

    .wa-share-btn:hover {
      background: #1eb956;
      transform: translateY(-2px);
    }

    @media (max-width: 580px) {
      .cat-cards-grid {
        grid-template-columns: 1fr;
      }
      .step-box {
        padding: 24px 18px 20px;
      }
    }
  </style>
  </Fragment>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href="index.html">🏠 Home</a>
    <span>/</span>
    <a href="reviews.html">Customer Reviews</a>
    <span>/</span>
    <strong style="color:var(--hb-brown);">⭐ Write a Review</strong>
  </div>

  <!-- HERO -->
  <div class="page-hero">
    <span class="page-hero-emoji">⭐</span>
    <h1>Share Your Experience!</h1>
    <p>Your honest parent review helps other families discover screen-free personalized learning 🍯</p>
  </div>

  <!-- PROGRESS -->
  <div class="progress-wrap">
    <div class="progress-label">
      <span id="progressText">Step 1 of 4 · About You</span>
      <span id="progressPct">25%</span>
    </div>
    <div class="progress-bar-bg">
      <div class="progress-bar-fill" id="progressFill" style="width:25%"></div>
    </div>
  </div>

  <!-- FORM CONTAINER -->
  <div class="review-card-container">

    <!-- ═══ STEP 1: ABOUT YOU ═══ -->
    <div class="step-box active" id="step1">
      <span class="step-badge">Step 1 of 4 · Basic Details</span>
      <h2 class="step-title">Who's sharing this review? 👋</h2>
      <p class="step-desc">We feature verified parent reviews on our website and community page.</p>

      <div class="form-group">
        <label for="revName" class="form-label">Your Full Name *</label>
        <input type="text" id="revName" class="rev-input" placeholder="e.g. Sangavi, Kavitha Saravanan" autocomplete="name" />
      </div>

      <div class="form-group">
        <label for="revLoc" class="form-label">Your City / Location *</label>
        <input type="text" id="revLoc" class="rev-input" placeholder="e.g. Madurai, Medavakkam, Chennai, Bangalore" />
      </div>

      <div class="form-group">
        <label for="revPhone" class="form-label">WhatsApp Number (Optional)</label>
        <input type="tel" id="revPhone" class="rev-input" placeholder="10-digit number for verification &amp; order points" />
      </div>

      <div class="form-group">
        <label for="revChild" class="form-label">Child's Name &amp; Age (Optional)</label>
        <input type="text" id="revChild" class="rev-input" placeholder="e.g. Aarav, 4 years" />
      </div>

      <div class="err-msg" id="err1">⚠️ Please fill in your name and location to proceed.</div>

      <div class="btn-row">
        <button type="button" class="btn-next" onclick="goNext(1)">Next: Choose Category →</button>
      </div>
    </div>

    <!-- ═══ STEP 2: CATEGORY SELECTION ═══ -->
    <div class="step-box" id="step2">
      <span class="step-badge">Step 2 of 4 · Select Product</span>
      <h2 class="step-title">Which HoneyBee product did you order? 📦</h2>
      <p class="step-desc">Select the category so we can show you specific, relevant questions:</p>

      <div class="cat-cards-grid" id="catSelectionGrid">
        <!-- Option 1: Reusable -->
        <div class="cat-card-option" data-cat="reusable" onclick="selectCategory('reusable', this)">
          <span class="cat-card-icon">♻️</span>
          <h3 class="cat-card-title">Reusable Books</h3>
          <p class="cat-card-subtitle">Write → Wipe → Reuse workbooks</p>
        </div>

        <!-- Option 2: Activity Books -->
        <div class="cat-card-option" data-cat="activity" onclick="selectCategory('activity', this)">
          <span class="cat-card-icon">🎨</span>
          <h3 class="cat-card-title">Theme Activity Books</h3>
          <p class="cat-card-subtitle">Personalised name activity books</p>
        </div>

        <!-- Option 3: Return Gifts -->
        <div class="cat-card-option" data-cat="return-gift" onclick="selectCategory('return-gift', this)">
          <span class="cat-card-icon">🎁</span>
          <h3 class="cat-card-title">Return Gifts</h3>
          <p class="cat-card-subtitle">Birthday &amp; party return gift packs</p>
        </div>

        <!-- Option 4: Divine Series -->
        <div class="cat-card-option" data-cat="divine" onclick="selectCategory('divine', this)">
          <span class="cat-card-icon">🪔</span>
          <h3 class="cat-card-title">Divine Series</h3>
          <p class="cat-card-subtitle">Personalised moral &amp; value storybooks</p>
        </div>
      </div>

      <div class="err-msg" id="err2">⚠️ Please choose the product category you are reviewing.</div>

      <div class="btn-row">
        <button type="button" class="btn-back" onclick="goBack(2)">← Back</button>
        <button type="button" class="btn-next" onclick="goNext(2)">Next: Product Experience →</button>
      </div>
    </div>

    <!-- ═══ STEP 3: CATEGORY-SPECIFIC FEEDBACK ═══ -->
    <div class="step-box" id="step3">
      <span class="step-badge" id="step3Badge">Step 3 of 4 · Product Experience</span>
      <h2 class="step-title" id="step3Title">Your Product Feedback</h2>
      <p class="step-desc">Please share your honest ratings on this product category:</p>

      <!-- 3A: REUSABLE BOOKS QUESTIONS -->
      <div id="catBlock_reusable" class="cat-feedback-block" style="display:none;">
        <div class="question-card-item">
          <div class="q-title">1. How useful did you find the write → wipe → reuse feature?</div>
          <div class="star-rater-row" data-qid="reusable_usefulness">
            <button type="button" class="star-btn" data-val="1" onclick="rateStar('reusable_usefulness', 1)">★</button>
            <button type="button" class="star-btn" data-val="2" onclick="rateStar('reusable_usefulness', 2)">★</button>
            <button type="button" class="star-btn" data-val="3" onclick="rateStar('reusable_usefulness', 3)">★</button>
            <button type="button" class="star-btn" data-val="4" onclick="rateStar('reusable_usefulness', 4)">★</button>
            <button type="button" class="star-btn" data-val="5" onclick="rateStar('reusable_usefulness', 5)">★</button>
            <span class="star-score-hint" id="hint_reusable_usefulness">Tap to rate</span>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">2. How many times has your child reused the book so far?</div>
          <div class="choice-chips-row" data-qid="reusable_times">
            <div class="choice-chip" onclick="pickSingleChoice('reusable_times', this, '1–5 times')">1–5 times</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_times', this, '5–10 times')">5–10 times</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_times', this, '10+ times')">10+ times</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_times', this, 'Regularly using it')">Regularly using it</div>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">3. How satisfied are you with the lamination / reusable quality?</div>
          <div class="star-rater-row" data-qid="reusable_quality">
            <button type="button" class="star-btn" data-val="1" onclick="rateStar('reusable_quality', 1)">★</button>
            <button type="button" class="star-btn" data-val="2" onclick="rateStar('reusable_quality', 2)">★</button>
            <button type="button" class="star-btn" data-val="3" onclick="rateStar('reusable_quality', 3)">★</button>
            <button type="button" class="star-btn" data-val="4" onclick="rateStar('reusable_quality', 4)">★</button>
            <button type="button" class="star-btn" data-val="5" onclick="rateStar('reusable_quality', 5)">★</button>
            <span class="star-score-hint" id="hint_reusable_quality">Tap to rate</span>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">4. How easy is it for your child to write and wipe the pages?</div>
          <div class="choice-chips-row" data-qid="reusable_ease">
            <div class="choice-chip" onclick="pickSingleChoice('reusable_ease', this, 'Very easy')">Very easy</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_ease', this, 'Easy')">Easy</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_ease', this, 'Needs some help')">Needs some help</div>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">5. Did the reusable format make you feel the product was better value than a one-time-use worksheet/book?</div>
          <div class="choice-chips-row" data-qid="reusable_value">
            <div class="choice-chip" onclick="pickSingleChoice('reusable_value', this, 'Yes')">Yes, definitely</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_value', this, 'Somewhat')">Somewhat</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_value', this, 'Not sure')">Not sure</div>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">6. How satisfied are you with the overall durability and finish?</div>
          <div class="star-rater-row" data-qid="reusable_durability">
            <button type="button" class="star-btn" data-val="1" onclick="rateStar('reusable_durability', 1)">★</button>
            <button type="button" class="star-btn" data-val="2" onclick="rateStar('reusable_durability', 2)">★</button>
            <button type="button" class="star-btn" data-val="3" onclick="rateStar('reusable_durability', 3)">★</button>
            <button type="button" class="star-btn" data-val="4" onclick="rateStar('reusable_durability', 4)">★</button>
            <button type="button" class="star-btn" data-val="5" onclick="rateStar('reusable_durability', 5)">★</button>
            <span class="star-score-hint" id="hint_reusable_durability">Tap to rate</span>
          </div>
        </div>

        <div class="question-card-item">
          <div class="q-title">7. Would you recommend Honeybee's reusable learning books to other parents?</div>
          <div class="choice-chips-row" data-qid="reusable_recommend">
            <div class="choice-chip" onclick="pickSingleChoice('reusable_recommend', this, 'Definitely')">Definitely!</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_recommend', this, 'Maybe')">Maybe</div>
            <div class="choice-chip" onclick="pickSingleChoice('reusable_recommend', this, 'No')">No</div>
          </div>
        </div>

        <div class="form-group" style="margin-top: 14px;">
          <label for="q_reusable_open" class="form-label">What do you like most about the reusable format?</label>
          <textarea id="q_reusable_open" class="rev-textarea" placeholder="e.g. My child can practise letters again and again without tearing or running out of sheets..."></textarea>
        </div>
      </div>

      <!-- 3B: THEME ACTIVITY BOOKS QUESTIONS -->
      <div id="catBlock_activity" class="cat-feedback-block" style="display:none;">
        <div class="question-card-item">
          <div class="q-title">1. How much did your child like their chosen theme?</div>
          <div class="star-rater-row" data-qid="act_theme_like">
            <button type="button" class="star-btn" data-val="1" onclick="rateStar('act_theme_like', 1)">★</button>
            <button type="button" class="star-btn" data-val="2" onclick="rateStar('act_theme_like', 2)">★</button>
            <button type="button" class="star-btn" data-val="3" onclick="rateStar('act_theme_like', 3)">★</button>
            <button type="button" class="star-btn" data-val="4" onclick="rateStar('act_theme_like', 4)">★</button>
            <button type="button" class="star-btn" data-val="5" onclick="rateStar('act_theme_like', 5)">★</button>
            <span class="star-score-hint" id="hint_act_theme_like">Tap to rate</span>
          </div>
